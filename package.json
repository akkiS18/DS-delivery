{
  "name": "ds-delivery-backend",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "engines": {
    "node": ">=24.7.0 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "start": "node --env-file=.env dist/src/server.js",
    "start:prod": "node dist/src/server.js",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "test:qa:db": "node --env-file=.env --import tsx --test src/tests/qa.system.db.test.ts",
    "test:qa:ui": "node --env-file=.env --import tsx --test src/tests/miniapp.ui.cdp.test.ts",
    "test:qa:process": "node --import tsx --test src/tests/reliability.proc.test.ts",
    "validate:postgres": "node --env-file=.env scripts/validate-postgres.mjs",
    "test:deploy": "node --import tsx --test src/lib/config-check.test.ts src/lib/shutdown.test.ts src/lib/health.test.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "build:prod": "prisma generate && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/modules/payment/uzcard.test.ts src/modules/payment/matching.test.ts src/bot/cart.test.ts",
    "test:db": "node --env-file=.env --import tsx --test src/tests/payment.db.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "smoke": "node --env-file=.env --import tsx src/tools/smoke.ts",
    "test:bot": "node --import tsx --test src/bot/cart.test.ts src/bot/checkout.test.ts",
    "smoke:checkout": "node --env-file=.env --import tsx src/tools/smoke-checkout.ts",
    "staff:link": "node --env-file=.env --import tsx src/tools/link-staff.ts",
    "test:restaurant": "node --import tsx --test src/modules/restaurant/workflow.test.ts",
    "smoke:restaurant": "node --env-file=.env --import tsx src/tools/smoke-restaurant.ts",
    "taxi:link": "node --env-file=.env --import tsx src/tools/link-taxi.ts",
    "restaurant:pickup": "node --env-file=.env --import tsx src/tools/set-pickup.ts",
    "test:taxi": "node --import tsx --test src/modules/taxi/workflow.test.ts",
    "smoke:taxi": "node --env-file=.env --import tsx src/tools/smoke-taxi.ts",
    "test:support": "node --import tsx --test src/modules/support/service.test.ts",
    "test:support:db": "node --env-file=.env --import tsx --test src/tests/support.db.test.ts",
    "test:acceptance": "node --import tsx --test src/modules/restaurant/acceptance.test.ts src/modules/restaurant/price-consent.test.ts",
    "restaurant:password": "node --env-file=.env --import tsx src/tools/set-restaurant-password.ts",
    "test:refunds": "node --import tsx --test src/modules/refunds/refund.test.ts",
    "test:refunds:db": "node --env-file=.env --import tsx --test src/tests/refunds.db.test.ts",
    "test:finance": "node --import tsx --test src/modules/commission/commission.test.ts",
    "test:finance:db": "node --env-file=.env --import tsx --test src/tests/finance.db.test.ts",
    "test:operations": "node --import tsx --test src/modules/restaurant-operations/operations.test.ts",
    "test:operations:db": "node --env-file=.env --import tsx --test src/tests/restaurant-operations.db.test.ts",
    "taxi:invite": "node --env-file=.env --import tsx src/tools/taxi-invite.ts",
    "test:taxi:db": "node --env-file=.env --import tsx --test src/tests/taxi.stage6d.db.test.ts",
    "test:setup": "node --env-file=.env --import tsx src/tools/setup-local-test.ts",
    "test:telegram:db": "node --env-file=.env --import tsx --test src/tests/telegram.integration.db.test.ts",
    "miniapp:dev-initdata": "node --env-file=.env --import tsx src/tools/miniapp-dev-initdata.ts",
    "test:miniapp:db": "node --env-file=.env --import tsx --test src/tests/miniapp.db.test.ts",
    "test:taxi:recovery:db": "node --env-file=.env --import tsx --test src/tests/taxi.recovery.db.test.ts",
    "miniapp:build": "npm --prefix apps/customer-miniapp run build",
    "test:checkout6f:db": "node --env-file=.env --import tsx --test src/tests/checkout.stage6f.db.test.ts",
    "test:orders:db": "node --env-file=.env --import tsx --test src/tests/restaurant-orders.db.test.ts",
    "test:catalog": "node --import tsx --test src/modules/restaurant-catalog/catalog.test.ts",
    "test:catalog:db": "node --env-file=.env --import tsx --test src/tests/restaurant-catalog.db.test.ts",
    "test:auth": "node --import tsx --test src/modules/restaurant-auth/auth.test.ts",
    "test:auth:db": "node --env-file=.env --import tsx --test src/tests/restaurant-auth.db.test.ts",
    "test:acceptance2:db": "node --env-file=.env --import tsx --test src/tests/acceptance2.db.test.ts",
    "test:acceptance:db": "node --env-file=.env --import tsx --test src/tests/acceptance.db.test.ts",
    "test:payment:safety": "node --env-file=.env --import tsx --test src/tests/payment.safety.db.test.ts",
    "test:support:conv": "node --env-file=.env --import tsx --test src/tests/support.conversation.db.test.ts",
    "taxi:add": "node --env-file=.env --import tsx src/tools/add-taxi.ts"
  },
  "dependencies": {
    "@prisma/client": "6.18.0",
    "fastify": "^5.3.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "6.18.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
