# Documents the variable NAMES of /opt/ds-prod/config/production.env (chmod 600, owner deploy, OUTSIDE the source tree and the Docker build context).
# `DS_ENV=production deploy/bin/init-config.sh <domain>` creates it with random secrets and SAFE defaults; change single values with
#   ssh -t ds-staging 'DS_ENV=production /opt/ds-prod/current/deploy/bin/set-secret.sh NAME'      (hidden prompt; never paste values into chat or Git)
# compose pins: NODE_ENV=production, DATABASE_URL (database ds_prod), HOST/PORT, TRUST_PROXY=1, BOT_PAYMENT_MODE=REAL, RECEIPT_DIR, GMAIL_*_FILE.

# --- identity / database ---
PROD_DOMAIN=                      # used by the watchdog; the edge proxy has its own copy in /opt/ds-edge/config/edge.env
POSTGRES_PASSWORD=                # letters/digits only (placed inside a postgresql:// URL)
INTERNAL_API_KEY=                 # operator key for /api/v1/internal (blocked at the edge; use it from the server only)
SHUTDOWN_TIMEOUT_SECONDS=15

# --- Telegram: production bots (NOT the staging test bots). Exactly ONE running backend per token. ---
BOT_ENABLED=false                 # true after BOT_TOKEN/TAXI_BOT_TOKEN are the production bots
BOT_TOKEN=
TAXI_BOT_TOKEN=                   # must differ from BOT_TOKEN
MINIAPP_ENABLED=true
MINIAPP_URL=                      # https://<PROD_DOMAIN>/app/
ANDROID_GUEST_ENABLED=true        # the customer APK signs guests in; the edge IP gate (PROD_ALLOW_IPS) decides who can reach the API at all
GUEST_BOOTSTRAP_PER_IP_HOUR=20
MAX_OPEN_UNPAID_ORDERS=           # default 2 per customer for REAL payments

# --- real card payments (docs/STAGE_8A.md). The backend REFUSES to start REAL payments in production unless ALL of these hold ---
GMAIL_ENABLED=false               # true = read the bank e-mails (needs the OAuth files in the gmail volume: bin/install-gmail-files.sh)
GMAIL_FROM=noreply@info.uzcard.uz
# GMAIL_AUTO_CONFIRM=false        # kill switch: unset = an exact trusted Gmail match confirms itself and cooking starts; false = the restaurant confirms in the app
# CONFIRM_REAL_PAYMENTS=yes       # the deliberate extra switch: set ONLY when the owner decides real money may flow
# Payee cards are entered by each restaurant in its app and approved in Telegram (/cards): there is no card number in this file.

# --- people ---
SUPPORT_ADMIN_1_TELEGRAM_ID=      # the platform administrators (/admin, /money, /cards, /commission, /restaurants, /support)
SUPPORT_ADMIN_2_TELEGRAM_ID=
TAXI_OPERATOR_ALLOWLIST=0         # real operator Telegram ids, comma separated ("0" = nobody, so no taxi can be dispatched)
TAXI_ALERT_TELEGRAM_ID=
WATCHDOG_CHAT_ID=                 # the owner's own Telegram id: the watchdog and the Gmail alerts reach this chat

# --- legal pages (/legal/privacy, /legal/terms): refused (503) until both are set ---
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_CONTACT=
# LEGAL_SUPPORT_HOURS=
RECEIPT_RETENTION_DAYS=365        # refund receipt photos of confirmed refunds are deleted after this many days (30..3650)

# --- off-server encrypted backup (deploy/bin/backup-offsite.sh) ---
# BACKUP_AGE_RECIPIENT=age1...    # the owner's PUBLIC age key; without it nothing is uploaded
# OFFSITE_RCLONE_REMOTE=          # rclone remote:bucket/path (credentials in /opt/ds-prod/config/rclone.conf)

# --- commission / taxi tuning (defaults are fine) ---
# COMMISSION_FLAT_SOM=5000
# TAXI_LEAD_MINUTES=4
# TAXI_OPERATOR_RESPONSE_SECONDS=180
# Stage 9 payment timing. The customer has 10 minutes to pay (default 600). A card is free again at once when the customer cancels or the payment is matched (0 = no wait); only an EXPIRED attempt keeps CARD_COOLDOWN_SECONDS (120).
# PAYMENT_WINDOW_SECONDS=600
# CARD_CANCEL_COOLDOWN_SECONDS=0
# CARD_MATCH_COOLDOWN_SECONDS=0
