# Template for deploy/production.env (git-ignored). Copy, then fill in. NEVER commit the filled-in file or paste tokens into chat.
# Variable NAMES only; every value below is a placeholder.

# --- database (compose builds DATABASE_URL from this) ---
# Use only letters, digits, '-' and '_' (e.g. `openssl rand -hex 24`): it is placed inside the postgresql:// URL, where '@', '/', ':' or '#' would break it.
POSTGRES_PASSWORD=

# --- runtime mode ---
# staging  = MOCK payments allowed (use for the first deployed test with a TEST bot)
# production = MOCK is refused by the backend; requires BOT_PAYMENT_MODE=REAL (see below)
NODE_ENV=staging
# Exactly one proxy (Caddy/nginx/Cloudflare) in front of the container:
TRUST_PROXY=1
INTERNAL_API_KEY=
SHUTDOWN_TIMEOUT_SECONDS=15

# --- Telegram (polling, exactly ONE running backend per token) ---
BOT_ENABLED=true
BOT_TOKEN=
TAXI_BOT_TOKEN=
MINIAPP_ENABLED=true
# Public HTTPS URL of the Mini App (the Vercel site until a permanent API/app host exists)
MINIAPP_URL=

# --- payments: MOCK by default. REAL needs bank/restaurant approval ---
BOT_PAYMENT_MODE=MOCK
GMAIL_ENABLED=false
# REAL only (all three are required together, in addition to GMAIL_ENABLED=true and NODE_ENV=production):
# BOT_REAL_CARD_NUMBERS_JSON=
# CONFIRM_REAL_PAYMENTS=yes

# --- taxi ---
TAXI_LEAD_MINUTES=7
TAXI_OPERATOR_RESPONSE_SECONDS=180
TAXI_WORKER_INTERVAL_SECONDS=5
# TAXI_OPERATOR_ALLOWLIST=
# TAXI_ALERT_TELEGRAM_ID=

# --- support / commission (optional) ---
# SUPPORT_ADMIN_1_TELEGRAM_ID=
# SUPPORT_ADMIN_2_TELEGRAM_ID=
# COMMISSION_FLAT_SOM=5000
