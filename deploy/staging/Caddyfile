# Staging edge. Automatic Let's Encrypt certificate + renewal for {$STAGING_DOMAIN}.
# Access model (Stage 7C-B2): the staging API runs MOCK checkout and anonymous guest sign-up, so it is NOT public.
# Everything except /health/live is answered only to STAGING_ALLOW_IPS (space-separated IPs/CIDRs from staging.env). Anyone else gets 403.
# remote_ip is the TCP peer address Caddy sees, never a client-supplied header, so a forged X-Forwarded-For cannot pass the gate.
{
	admin off
	servers {
		protocols h1 h2
	}
}

{$STAGING_DOMAIN} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	log {
		output stdout
		format json
	}

	# Liveness only: the body is {"ok":true}-style, no data and no DB access.
	@live path /health/live
	handle @live {
		reverse_proxy backend:4000
	}

	@allowed remote_ip {$STAGING_ALLOW_IPS}
	handle @allowed {
		# Caddy replaces any X-Forwarded-For sent by the client with the real peer address (client headers are untrusted unless trusted_proxies is set).
		reverse_proxy backend:4000
	}

	handle {
		respond "Forbidden" 403
	}
}
