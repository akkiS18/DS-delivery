# Local Telegram + Android integration testing. Copy to .env (never commit .env) and fill the <...> values.
# Everything here is MOCK-only: no real payments, Gmail off, taxi requests only to YOUR OWN Telegram account.

# MUST end in /ds_delivery_test. The server logs the database name at start-up.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ds_delivery_test?schema=public
HOST=0.0.0.0
PORT=4000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=<64 hex chars>

GMAIL_ENABLED=false

# Token of a SEPARATE test bot created with @BotFather (see docs/TELEGRAM_LOCAL_TESTING.md). One process per token.
BOT_ENABLED=true
BOT_TOKEN=<token from BotFather>
BOT_PAYMENT_MODE=MOCK

# Dedicated taxi operator bot: a SECOND bot from @BotFather, different token from BOT_TOKEN (optional; unset = legacy mode).
TAXI_BOT_TOKEN=<token of the taxi bot>
# Seconds an accepted booking may wait for "Taksi yuborildi" before it is flagged as needing help.
TAXI_ACCEPT_TO_SENT_SECONDS=900

# Stage 6E: restaurants work in the Android app. The old Telegram staff panel is OFF unless this is "true" (rollback only).
RESTAURANT_TELEGRAM_ENABLED=false

# Stage 6F: orders are created automatically after server-side validation and start at "payment pending". There is no routine restaurant
# acceptance. Rollback only (old accept-first flow): RESTAURANT_MANUAL_ACCEPTANCE=true. RESTAURANT_ACCEPTANCE_MOCK is retired.
# RESTAURANT_MANUAL_ACCEPTANCE=false

# Only these Telegram ids can ever receive a taxi request (use your own id). Others are blocked, nothing is sent.
TAXI_OPERATOR_ALLOWLIST=<your telegram id>
TAXI_LEAD_MINUTES=7

# Stage 7A: Customer Telegram Mini App (served by this backend at /app/, same origin as /api).
MINIAPP_ENABLED=true
# Public HTTPS URL of THIS server (tunnel for local testing, see docs/STAGE_7A.md). Telegram rejects http:// and localhost.
MINIAPP_URL=https://<your-tunnel-host>/app/
MINIAPP_AUTH_MAX_AGE_SECONDS=86400
MINIAPP_ORDER_RATE_PER_MINUTE=10
# Default true (old chat checkout stays reachable) until the Mini App passes real-Telegram E2E; then set false.
CHAT_CHECKOUT_ENABLED=true

# Stage 7A: taxi silence recovery. Silence is escalated to administrators; it is never re-sent automatically unless you opt in (risk: double booking).
TAXI_SILENCE_ESCALATION_SECONDS=300
TAXI_AUTO_FALLBACK_ON_SILENCE=false
TRUST_PROXY=false
