generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                  String                @id @default(cuid())
  slug                String                @unique
  name                String
  isActive            Boolean               @default(true)
  isPaused            Boolean               @default(false)
  /// Paid on the platform's own card pool (Card.restaurantId = null) instead of cards of its own (owner decision 2026-10-30).
  collectsToPlatform  Boolean               @default(false)
  /// "Shirin" mode (owner decision 2026-11-04): the restaurant itself checks that the customer's transfer to its own card arrived (Payment.method CARD_MANUAL). Exclusive with collectsToPlatform.
  manualPaymentCheck  Boolean               @default(false)
  /// "Yaqin, piyoda mumkin" is offered to customers only where this is on (owner decision 2026-10-31: Sifat Food only).
  walkingDeliveryEnabled Boolean            @default(false)
  defaultPrepMinutes  Int                   @default(25)
  /// Table reservations (off until the restaurant switches them on): the deposit is paid to the restaurant's card.
  reservationsEnabled   Boolean             @default(false)
  reservationDepositSom Int                 @default(100000)
  reservations          Reservation[]
  /// IANA zone in which workingHours are evaluated for new checkouts.
  timezone            String                @default("Asia/Tashkent")
  workingHours        Json?
  staffTelegramUserId String?               @unique
  staffLinkedAt       DateTime?             @db.Timestamptz(3)
  pickupAddress       String?
  pickupPhone         String?
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)
  categories          Category[]
  products            Product[]
  orders              Order[]
  cards               Card[]
  payments            Payment[]
  credential          RestaurantCredential?
  catalogEvents       CatalogEvent[]
  sessions            RestaurantSession[]
  commissionEntries   CommissionEntry[]
  commissionSettlements CommissionSettlement[]
  commissionWaivers   CommissionWaiver[]
  financePin          RestaurantFinancePin?
  payoutMarks         PayoutMark[]
  ratings             OrderRating[]
  image               RestaurantImage?
  promotions          Promotion[]
  banners             Banner[]
  // Company dispatch pickup site
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  position     Int        @default(0)
  version      Int        @default(0)
  products     Product[]
  image        CategoryImage?

  @@index([restaurantId, position])
}

model Product {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  priceSom     Int
  isAvailable  Boolean     @default(true)
  imageUrl     String?
  // Stage 5B: products are archived, never hard-deleted (order lines keep their snapshot and productId).
  // DB CHECK: archivedAt IS NULL OR isAvailable = false. version = optimistic-lock counter.
  archivedAt   DateTime?   @db.Timestamptz(3)
  version      Int         @default(0)
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @db.Timestamptz(3)
  orderItems   OrderItem[]
  image        ProductImage?
  /// Packaging that goes with this dish ("soboy idishi"): the server adds one packaging unit per dish unit at checkout (owner decision 2026-11-01).
  packagingProductId String?
  packagingProduct   Product?    @relation("DishPackaging", fields: [packagingProductId], references: [id], onDelete: SetNull)
  packagedDishes     Product[]   @relation("DishPackaging")
  /// A packaging product: never listed on the customer menu on its own, only added next to its dish. Still editable (price) in the restaurant app.
  isPackaging  Boolean     @default(false)
  /// Order on the customer menu inside a category (small first); equal positions fall back to the name. Set by an administrator; 0 = no preference.
  position     Int         @default(0)
  /// Display only: the earlier price, shown crossed out next to priceSom (a set offer, 2026-11-06). Never used to charge; cleared when the restaurant changes priceSom.
  oldPriceSom  Int?
  promotionProducts PromotionProduct[]

  @@index([restaurantId, isAvailable])
}

model TaxiCompany {
  id                     String         @id @default(cuid())
  name                   String         @unique
  isActive               Boolean        @default(true)
  operatorTelegramUserId String?        @unique
  operatorLinkedAt       DateTime?      @db.Timestamptz(3)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  orders                 Order[]
  dispatches             TaxiDispatch[]
  invites                TaxiOperatorInvite[]
  credential             TaxiCredential?
  sessions               TaxiSession[]
  demoRequest            TaxiDemoRequest?
}

/// Admin "sinov" taxi request (/demo in the admin bot): a fake request that only the company's own DS Taxi app shows, to explain the operator's buttons.
/// It is NOT a TaxiDispatch and has no Order: the dispatch worker, the restaurant, the customer, commission and the admin alerts never see it. One per company.
model TaxiDemoRequest {
  id            String              @id @default(cuid())
  taxiCompanyId String              @unique
  taxiCompany   TaxiCompany        @relation(fields: [taxiCompanyId], references: [id], onDelete: Cascade)
  code          String
  status        TaxiDispatchStatus  @default(REQUESTED)
  /// true = the driver pays the restaurant at pickup (shows the cash line), false = already paid by card.
  cash          Boolean             @default(false)
  totalSom      Int
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
}

/// Taxi operator app login (one shared login per company). passwordHash is Argon2id and never returned by any API.
model TaxiCredential {
  id                String      @id @default(cuid())
  taxiCompanyId     String      @unique
  taxiCompany       TaxiCompany @relation(fields: [taxiCompanyId], references: [id], onDelete: Cascade)
  login             String      @unique
  passwordHash      String
  passwordVersion   Int         @default(1)
  passwordChangedAt DateTime    @default(now()) @db.Timestamptz(3)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)
}

/// Only a SHA-256 of the bearer token is stored. lastSeenAt doubles as the operator app heartbeat.
model TaxiSession {
  id              String      @id @default(cuid())
  tokenHash       String      @unique
  taxiCompanyId   String
  taxiCompany     TaxiCompany @relation(fields: [taxiCompanyId], references: [id], onDelete: Cascade)
  passwordVersion Int
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime    @db.Timestamptz(3)
  lastSeenAt      DateTime    @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?   @db.Timestamptz(3)

  @@index([taxiCompanyId, revokedAt, expiresAt])
}

model TaxiOperatorInvite {
  id               String      @id @default(cuid())
  taxiCompanyId    String
  taxiCompany      TaxiCompany @relation(fields: [taxiCompanyId], references: [id], onDelete: Cascade)
  codeHash         String      @unique
  expiresAt        DateTime    @db.Timestamptz(3)
  usedAt           DateTime?   @db.Timestamptz(3)
  usedByTelegramId String?
  createdBy        String
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)

  @@index([taxiCompanyId])
}

/// telegramUserId is NULL for an Android guest profile (no fake Telegram id is ever invented). It is set when the guest links Telegram.
/// mergedIntoId is set on a guest row whose data moved into an existing Telegram customer; such a row never serves requests again.
model Customer {
  id             String          @id @default(cuid())
  telegramUserId String?         @unique
  displayName    String?
  phone          String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  mergedIntoId   String?
  mergedInto     Customer?       @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     Customer[]      @relation("CustomerMerge")
  orders         Order[]
  reservations   Reservation[]
  supportTickets SupportTicket[]
  ratings        OrderRating[]
  addresses      CustomerAddress[]
  guestSessions  GuestSession[]
  linkAttempts   TelegramLinkAttempt[]
  strikes        CustomerStrike[]
  /// Admin block (owner decision 2026-10-30): the customer cannot order at all. Five active strikes block as well (customer-strikes/service.ts).
  blockedAt      DateTime?       @db.Timestamptz(3)
  blockedBy      String?
  blockNote      String?
  /// Play Store / privacy: the person asked for the account to be deleted. Personal data is erased (account-deletion.ts), the row stays so orders, payments and the ledger keep their references.
  deletedAt      DateTime?       @db.Timestamptz(3)

  @@index([mergedIntoId])
}

/// Android guest session. The credential is a server-generated random secret shown once; only its SHA-256 is stored.
/// installationId is a random client-made helper label, never a credential.
model GuestSession {
  id             String    @id @default(cuid())
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  tokenHash      String    @unique
  installationId String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedReason  String?

  @@index([customerId])
}

enum TelegramLinkStatus {
  CREATED
  BOT_BOUND
  BOT_CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Optional guest -> Telegram link. Needs the bot owner's confirmation in Telegram AND the app owner's confirmation in the app.
model TelegramLinkAttempt {
  id               String             @id @default(cuid())
  guestCustomerId  String
  guestCustomer    Customer           @relation(fields: [guestCustomerId], references: [id])
  sessionId        String
  tokenHash        String             @unique
  status           TelegramLinkStatus @default(CREATED)
  telegramUserId   String?
  telegramName     String?
  telegramUsername String?
  targetCustomerId String?
  mergeSummary     Json?
  expiresAt        DateTime           @db.Timestamptz(3)
  botBoundAt       DateTime?          @db.Timestamptz(3)
  botConfirmedAt   DateTime?          @db.Timestamptz(3)
  completedAt      DateTime?          @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)

  @@index([guestCustomerId, status])
}

/// Stage 7A: saved delivery addresses of a customer (Mini App profile). Orders copy the text; they never reference this row.
model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String
  addressText String
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false)
  lastUsedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([customerId])
}

enum OrderStatus {
  WAITING_RESTAURANT
  WAITING_CUSTOMER_CONSENT
  CUSTOMER_CANCELLED
  RESTAURANT_REJECTED
  RESTAURANT_EXPIRED
  PAYMENT_PENDING
  PAYMENT_EXPIRED
  PAYMENT_MATCHED_UNVERIFIED
  PAYMENT_CONFIRMED
  ACCEPTED
  PREPARING
  READY
  TAXI_REQUESTED
  DRIVER_ASSIGNED
  DELIVERY_ASSUMED
  COMPLETED
  CANCELLATION_REQUESTED
  CANCELLED
  FAILED
}

model Order {
  id                         String               @id @default(cuid())
  number                     Int                  @unique @default(autoincrement())
  /// Public reference shown to people (internal `number` is never shown: it would reveal order volume). Generated by gen_order_code().
  code                       String               @unique @default(dbgenerated("gen_order_code()"))
  restaurantId               String
  restaurant                 Restaurant           @relation(fields: [restaurantId], references: [id])
  customerId                 String
  customer                   Customer             @relation(fields: [customerId], references: [id])
  checkoutKey                String?              @unique
  phoneSnapshot              String?
  taxiCompanyId              String?
  taxiCompany                TaxiCompany?         @relation(fields: [taxiCompanyId], references: [id])
  createdViaBot              Boolean              @default(false)
  /// Admin "sinov buyurtma" (/demo in the admin bot): a fake order shown in the restaurant app to explain it. Never paid, never reaches history, finance or the taxi; deleted by the sweep (restaurant-orders/demo.ts).
  isDemo                     Boolean              @default(false)
  allowTaxiFallback          Boolean              @default(false)
  status                     OrderStatus          @default(PAYMENT_PENDING)
  // Stage 4B-1: restaurant acceptance happens before any payment exists.
  paymentIsTest              Boolean              @default(false)
  restaurantDeadlineAt       DateTime?            @db.Timestamptz(3)
  acceptedAt                 DateTime?            @db.Timestamptz(3)
  acceptedBy                 String?
  estimatedPrepMinutes       Int?
  rejectedAt                 DateTime?            @db.Timestamptz(3)
  rejectedBy                 String?
  rejectReason               String?
  cancelledAt                DateTime?            @db.Timestamptz(3)
  cancelledBy                String?
  cancelReason               String?
  priceRevisions             OrderPriceRevision[]
  paymentVerifiedAt          DateTime?            @db.Timestamptz(3)
  paymentVerifiedBy          String?
  prepMinutes                Int?
  preparingStartedAt         DateTime?            @db.Timestamptz(3)
  readyAt                    DateTime?            @db.Timestamptz(3)
  // The restaurant states, after the payment, in how many minutes the food will be ready (5..60, from the moment of choosing).
  // prepMinutes stays the clock the customer and the taxi scheduler use (chosen minutes + minutes already elapsed); these two are the clean record.
  prepChosenMinutes          Int?
  prepChosenAt               DateTime?            @db.Timestamptz(3)
  // Stage 9: the customer said "I received it" (a signal next to the taxi operator's confirmation, never a replacement for it).
  customerReceivedAt         DateTime?            @db.Timestamptz(3)
  // Walking / self delivery (owner decision 2026-10-27). deliveryPreference: what the customer allowed at checkout (TAXI = taxi only, WALK_OK = "my home is
  // close, the restaurant may bring it on foot"). deliveryMode: what actually happens, decided by the restaurant at "Tayyor" (SELF only if WALK_OK).
  // A SELF order never gets a taxi dispatch (database trigger) and is completed by the restaurant (selfDeliveredAt).
  deliveryPreference         String               @default("TAXI")
  deliveryMode               String               @default("TAXI")
  selfDeliveredAt            DateTime?            @db.Timestamptz(3)
  staffLastNotifiedStatus    String?
  customerLastNotifiedStatus String?
  events                     OrderEvent[]
  taxiDispatches             TaxiDispatch[]
  supportTickets             SupportTicket[]
  rating                     OrderRating?
  refundRequests             RefundRequest[]
  commission                 CommissionEntry?
  customerStrikes            CustomerStrike[]
  addressText                String
  deliveryLat                Float?
  deliveryLng                Float?
  totalSom                   Int
  // Service fee (platform fee baked into the dish prices). null on legacy/FLAT orders: the customer paid the menu prices and the flat commission applies.
  // When set: totalSom = baseTotalSom + serviceFeeSom; baseTotalSom is what the restaurant's own menu prices add up to. serviceFeeSom is the platform's frozen share.
  baseTotalSom               Int?
  serviceFeeSom              Int?
  feeRuleCode                String?
  /// Menu value of the free units given by a promotion (1+1); 0 = none. The free units are order lines priced 0.
  promoDiscountSom           Int                  @default(0)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  items                      OrderItem[]
  payment                    Payment?

  @@index([restaurantId, createdAt])
  @@index([customerId, createdAt])
  @@index([taxiCompanyId])
  @@index([status, restaurantDeadlineAt])
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  unitSom      Int
  quantity     Int
  subtotalSom  Int
  /// The restaurant's own menu price when unitSom includes the service fee; null = unitSom is the menu price.
  baseUnitSom  Int?
  // Stage 4B-2: a consented price revision replaces the lines; old lines are kept, only marked superseded.
  supersededAt DateTime? @db.Timestamptz(3)

  @@index([orderId])
}

// Stage 4B-2 - restaurant-proposed price change that needs explicit customer consent.
// status: PROPOSED | ACCEPTED | DECLINED | EXPIRED | VOID. One PROPOSED per order (partial unique index in SQL).
model OrderPriceRevision {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        String    @default("PROPOSED")
  proposedBy    String
  proposedAt    DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  respondedAt   DateTime? @db.Timestamptz(3)
  oldTotalSom   Int
  newTotalSom   Int
  prepMinutes   Int
  previousLines Json
  lines         Json

  @@index([orderId, status])
  @@index([status, expiresAt])
}

// Ported from the tested PaymentService V3.
// These are application-accounted matches, NOT verified bank settlements.
model Card {
  id             String         @id @default(cuid())
  restaurantId   String?
  restaurant     Restaurant?    @relation(fields: [restaurantId], references: [id])
  last4          String         @unique
  label          String         @default("UZCARD")
  isTest         Boolean        @default(false)
  active         Boolean        @default(true)
  lastAssignedAt DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  payments       Payment[]
  cooldowns      CardCooldown[]
  events         CardEvent[]
  // Stage 8B: payee number managed in the restaurant app. number is NULL for legacy cards; approvalStatus gates assignment.
  // The partial unique index Card_number_key lives only in the migration SQL.
  number          String?
  approvalStatus  String         @default("APPROVED")
  decidedAt       DateTime?      @db.Timestamptz(3)
  decidedBy       String?
  adminNotifiedAt DateTime?      @db.Timestamptz(3)
  // Stage 9: the name printed on the card, shown to the paying customer so they can see they are paying the right person.
  holderName      String?

  @@index([restaurantId, isTest, active])
}

model CardEvent {
  id        String   @id @default(cuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  action    String
  actorType String
  actorId   String?
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([cardId, createdAt])
}

model Payment {
  id                    String            @id @default(cuid())
  number                Int               @unique @default(autoincrement())
  orderId               String?           @unique
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  restaurantId          String?
  restaurant            Restaurant?       @relation(fields: [restaurantId], references: [id])
  amountTiyin           BigInt
  status                String            @default("QUEUED")
  /// CARD = bank transfer to a restaurant card (matched from the bank e-mail); CASH = the customer pays the courier on delivery (statuses CASH_PENDING -> CASH_ACCEPTED, no card);
  /// CARD_MANUAL = transfer to the restaurant's own card that the RESTAURANT confirms by itself (RESTAURANT_CHECK -> CONFIRMED_MANUAL; never linked to a bank signal).
  method                String            @default("CARD")
  isTest                Boolean           @default(false)
  isStress              Boolean           @default(false)
  cardId                String?
  card                  Card?             @relation(fields: [cardId], references: [id])
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  assignedAt            DateTime?         @db.Timestamptz(3)
  expiresAt             DateTime?         @db.Timestamptz(3)
  matchedAt             DateTime?         @db.Timestamptz(3)
  matchedTransactionId  String?           @unique
  reservation           Reservation?
  events                PaymentEvent[]
  refundRequests        RefundRequest[]
  commissionEntries     CommissionEntry[]
  botLastNotifiedStatus String?

  @@index([status, number])
  @@index([restaurantId, status, amountTiyin])
  @@index([cardId, amountTiyin, assignedAt])
  @@index([isTest, amountTiyin, status])
  @@index([isStress])
}

/// A table reservation with a deposit paid to the restaurant's card through the normal payment engine (a Payment without an order).
/// PENDING_PAYMENT -> PAID (money matched and confirmed) | EXPIRED (payment window passed) ; PAID -> CANCELLED (the restaurant, after contacting the customer).
model Reservation {
  id                   String     @id @default(cuid())
  /// Public reference shown to people (internal ids are never shown).
  code                 String     @unique
  restaurantId         String
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])
  customerId           String
  customer             Customer   @relation(fields: [customerId], references: [id])
  paymentId            String     @unique
  payment              Payment    @relation(fields: [paymentId], references: [id])
  checkoutKey          String?    @unique
  startsAt             DateTime   @db.Timestamptz(3)
  partySize            Int
  note                 String?
  phoneSnapshot        String
  nameSnapshot         String?
  depositSom           Int
  status               String     @default("PENDING_PAYMENT")
  paidAt               DateTime?  @db.Timestamptz(3)
  paidBy               String?
  restaurantNotifiedAt DateTime?  @db.Timestamptz(3)
  restaurantSeenAt     DateTime?  @db.Timestamptz(3)
  cancelledAt          DateTime?  @db.Timestamptz(3)
  cancelReason         String?
  createdAt            DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @db.Timestamptz(3)

  @@index([restaurantId, startsAt])
  @@index([customerId, createdAt])
  @@index([status])
}

model CardCooldown {
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  amountTiyin BigInt
  until       DateTime @db.Timestamptz(3)

  @@id([cardId, amountTiyin])
}

model IncomingTransaction {
  id               String    @id @default(cuid())
  sourceId         String    @unique
  source           String
  cardLast4        String
  amountTiyin      BigInt
  occurredAt       DateTime  @db.Timestamptz(3)
  receivedAt       DateTime  @default(now()) @db.Timestamptz(3)
  emailReceivedAt  DateTime? @db.Timestamptz(3)
  minutePrecision  Boolean   @default(true)
  trustedSender    Boolean   @default(false)
  status           String    @default("REVIEW_REQUIRED")
  reason           String?
  // Unique: one verified incoming payment can be assigned to at most one payment.
  matchedPaymentId String?   @unique
  fingerprint      String?
  reviewDetails    Json?
  // Stage 8C: set when an administrator closes a review with a decision and a note (CHECK: all or none).
  handledAt        DateTime? @db.Timestamptz(3)
  handledBy        String?
  handledAction    String?
  handledNote      String?

  @@index([fingerprint])
  @@index([cardLast4, amountTiyin, occurredAt])
  @@index([status, receivedAt])
}

// Stage 4A - append-only history of payment attempt state transitions (system and restaurant actor).
model PaymentEvent {
  id                    String   @id @default(cuid())
  paymentId             String
  payment               Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  action                String
  fromStatus            String?
  toStatus              String?
  actorType             String
  actorId               String?
  incomingTransactionId String?
  details               Json?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@index([paymentId, createdAt])
}

model GmailIngestion {
  gmailId   String   @id
  status    String
  reason    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// Actor / previous state / next state are retained for payment and preparation decisions.
model OrderEvent {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorTelegramId String
  actorType       String
  action          String
  fromStatus      OrderStatus
  toStatus        OrderStatus
  details         Json?
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

// Dispatches are independent from kitchen order status. A driver can be sent
// while the meal is still PREPARING. No 'DELIVERED' claim is made here.
enum TaxiDispatchStatus {
  SCHEDULED
  SENDING
  REQUESTED
  CANCELLATION_PENDING
  ASSIGNED
  DECLINED
  NEEDS_HELP
  CANCELLED
  ACCEPTED
  DELIVERED
}

model TaxiDispatch {
  id                 String             @id @default(cuid())
  orderId            String
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taxiCompanyId      String
  taxiCompany        TaxiCompany        @relation(fields: [taxiCompanyId], references: [id])
  attemptNo          Int
  status             TaxiDispatchStatus @default(SCHEDULED)
  dueAt              DateTime           @db.Timestamptz(3)
  leaseAt            DateTime?          @db.Timestamptz(3)
  sentAt             DateTime?          @db.Timestamptz(3)
  expiresAt          DateTime?          @db.Timestamptz(3)
  respondedAt        DateTime?          @db.Timestamptz(3)
  cancelNoticeAt     DateTime?          @db.Timestamptz(3)
  cancelNoticeTries  Int                @default(0)
  telegramMessageId  Int?
  sendTries          Int                @default(0)
  customerNotifiedAt DateTime?          @db.Timestamptz(3)
  staffNotifiedAt    DateTime?          @db.Timestamptz(3)
  adminNotifiedAt    DateTime?          @db.Timestamptz(3)
  acceptedAt         DateTime?          @db.Timestamptz(3)
  acceptedBy         String?
  dispatchedAt       DateTime?          @db.Timestamptz(3)
  dispatchedBy       String?
  deliveredAt        DateTime?          @db.Timestamptz(3)
  deliveredBy        String?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([orderId, attemptNo])
  @@index([status, dueAt])
  @@index([orderId, status])
}

// Stage 3B — customer support tickets handled by two equal Telegram admins.
// DB CHECK + partial unique index live in the migration SQL (Prisma cannot express them).
enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id                      String                      @id @default(cuid())
  number                  Int                         @unique @default(autoincrement())
  orderId                 String
  order                   Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId              String
  customer                Customer                    @relation(fields: [customerId], references: [id])
  message                 String
  status                  SupportTicketStatus         @default(OPEN)
  assignedAdminTelegramId String?
  assignedAdminName       String?
  claimedAt               DateTime?                   @db.Timestamptz(3)
  resolvedAt              DateTime?                   @db.Timestamptz(3)
  customerNotifiedAt      DateTime?                   @db.Timestamptz(3)
  // When the customer last opened the ticket in an app (unread = a newer admin message or resolution).
  customerSeenAt          DateTime?                   @db.Timestamptz(3)
  createdAt               DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                    @updatedAt @db.Timestamptz(3)
  notifications           SupportTicketNotification[]
  events                  SupportTicketEvent[]
  messages                SupportTicketMessage[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId])
}

// One admin chat message per ticket and admin, so it can be edited after a claim.
model SupportTicketNotification {
  id              String        @id @default(cuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  adminTelegramId String
  messageId       Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([ticketId, adminTelegramId])
}

// Append-only audit history.
model SupportTicketEvent {
  id              String               @id @default(cuid())
  ticketId        String
  ticket          SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorTelegramId String
  actorType       String
  action          String
  fromStatus      SupportTicketStatus?
  toStatus        SupportTicketStatus?
  details         Json?
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)

  @@index([ticketId, createdAt])
}

// Telegram callback_query ids already processed (duplicate delivery / double tap guard).
model SupportCallbackLog {
  callbackQueryId String   @id
  ticketId        String
  actorTelegramId String
  action          String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

// Stage 3C - conversation between the customer and the assigned admin, with delivery tracking.
// senderType is 'CUSTOMER' | 'ADMIN' (CHECK in migration). (senderTelegramId, telegramMessageId) dedupes redelivered updates.
model SupportTicketMessage {
  id                String        @id @default(cuid())
  ticketId          String
  ticket            SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType        String
  senderTelegramId  String
  senderName        String?
  // Null for a message written in an app (the sender id is then 'app:<customerId>' and clientKey is the dedupe key).
  telegramMessageId Int?
  clientKey         String?
  text              String
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  deliveredAt       DateTime?     @db.Timestamptz(3)
  deliveryAttempts  Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @db.Timestamptz(3)
  failedAt          DateTime?     @db.Timestamptz(3)
  lastError         String?

  @@unique([senderTelegramId, telegramMessageId])
  @@unique([senderTelegramId, clientKey])
  @@index([ticketId, createdAt])
  @@index([deliveredAt, failedAt, nextAttemptAt])
}

// Stage 5A - restaurant API authentication (Android APK). One shared login per restaurant (MVP).
// passwordHash is an Argon2id PHC string and must never be returned by any API.
model RestaurantCredential {
  id                String     @id @default(cuid())
  restaurantId      String     @unique
  restaurant        Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  passwordHash      String
  // Bumped on every password change; sessions created under an older version are rejected.
  passwordVersion   Int        @default(1)
  passwordChangedAt DateTime   @default(now()) @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @db.Timestamptz(3)
}

// Only a SHA-256 of the bearer token is stored; the token itself is shown to the client once.
model RestaurantSession {
  id              String     @id @default(cuid())
  tokenHash       String     @unique
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  passwordVersion Int
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime   @db.Timestamptz(3)
  lastSeenAt      DateTime   @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime?  @db.Timestamptz(3)
  /// Finance PIN entered on this session: money screens are open until this instant (sliding); null = locked.
  financeUnlockedUntil DateTime? @db.Timestamptz(3)

  @@index([restaurantId, revokedAt, expiresAt])
}

/// The 4-digit code that opens the restaurant's money screens. Issued by an administrator (shown once); only the hash is stored.
model RestaurantFinancePin {
  id             String     @id @default(cuid())
  restaurantId   String     @unique
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  pinHash        String
  setBy          String
  failedAttempts Int        @default(0)
  lockedUntil    DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
}

// Login throttling. keyHash = sha256("slug:<slug>") or sha256("ip:<ip>"); no raw identifiers are stored.
model RestaurantLoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

// Stage 5B - append-only history of restaurant catalog changes made through the API.
// actorSessionId identifies the (shared-login) session that made the change.
model CatalogEvent {
  id             String     @id @default(cuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  entity         String
  entityId       String
  action         String
  actorSessionId String
  before         Json?
  after          Json?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([restaurantId, createdAt])
  @@index([entity, entityId, createdAt])
}

// Stage 6A - manual refund workflow. DS Delivery never holds or moves money: the RESTAURANT refunds from its own
// account; this table only records the request, the restaurant's decision and the attestations.
// status: REQUESTED | APPROVED | REJECTED | SENT | CONFIRMED | DISPUTED. DB CHECKs and partial unique indexes
// (one open request per order, one open-or-completed request per payment) live in the migration SQL.
model RefundRequest {
  id                         String        @id @default(cuid())
  number                     Int           @unique @default(autoincrement())
  orderId                    String
  order                      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId                  String
  payment                    Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind                       String
  status                     String        @default("REQUESTED")
  reasonCode                 String
  reasonNote                 String?
  paidAmountTiyin            BigInt
  approvedAmountTiyin        BigInt?
  orderStatusBefore          String
  paymentStatusAtRequest     String
  taxiActiveAtDecision       Boolean       @default(false)
  requestedBy                String
  requestedByType            String
  requestedAt                DateTime      @default(now()) @db.Timestamptz(3)
  decidedBy                  String?
  decidedAt                  DateTime?     @db.Timestamptz(3)
  rejectReason               String?
  sentBy                     String?
  sentAt                     DateTime?     @db.Timestamptz(3)
  bankReference              String?
  // Proof of a sent refund: one photo of the bank receipt (bytes on the server volume, never in the database). Replaces the typed reference for
  // new refunds; bankReference stays for rows created before. See migration 20261030000100_refund_receipt.
  receiptKey                 String?
  receiptMime                String?
  receiptBytes               Int?
  receiptSha256              String?
  receiptPurgedAt DateTime? @db.Timestamptz(3)
  confirmedBy                String?
  confirmedByType            String?
  confirmedAt                DateTime?     @db.Timestamptz(3)
  confirmNote                String?
  disputedAt                 DateTime?     @db.Timestamptz(3)
  staffNotifiedAt            DateTime?     @db.Timestamptz(3)
  adminNotifiedAt            DateTime?     @db.Timestamptz(3)
  customerDecisionNotifiedAt DateTime?     @db.Timestamptz(3)
  customerSentNotifiedAt     DateTime?     @db.Timestamptz(3)
  disputeNotifiedAt          DateTime?     @db.Timestamptz(3)
  events                     RefundEvent[]

  @@index([orderId])
  @@index([status, requestedAt])
}

// Append-only audit trail of every refund state change and rejected attempt.
model RefundEvent {
  id         String        @id @default(cuid())
  refundId   String
  refund     RefundRequest @relation(fields: [refundId], references: [id], onDelete: Cascade)
  actorId    String
  actorType  String
  action     String
  fromStatus String?
  toStatus   String?
  details    Json?
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([refundId, createdAt])
}

// Stage 6B - platform commission ledger. APPEND-ONLY (DB triggers forbid UPDATE/DELETE).
// A row exists only for an order that reached COMPLETED with a COMPLETED OrderEvent as proof, a restaurant-verified
// non-test payment and no refund request. amountSom is the amount applied at that moment; later config changes never touch it.
// The restaurant owes the platform this amount; the platform collects nothing automatically.
model CommissionEntry {
  id            String            @id @default(cuid())
  number        Int               @unique @default(autoincrement())
  orderId       String            @unique
  order         Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  restaurantId  String
  restaurant    Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  paymentId     String
  payment       Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  kind          String            @default("ACCRUAL")
  amountSom     Int
  orderTotalSom Int
  ruleCode      String
  proofEventId  String
  accruedBy     String
  accruedAt     DateTime          @default(now()) @db.Timestamptz(3)
  events        CommissionEvent[]
  settlement    CommissionSettlementEntry?
  waiver        CommissionWaiver?

  @@index([restaurantId, accruedAt])
}

/// Stage 8C: an administrator verified in the bank that the restaurant paid the commission for these ledger entries. Append-only.
model CommissionSettlement {
  id           String                      @id @default(cuid())
  number       Int                         @unique @default(autoincrement())
  restaurantId String
  restaurant   Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  cutoffAt     DateTime                    @db.Timestamptz(3)
  entryCount   Int
  amountSom    Int
  confirmedBy  String
  note         String
  createdAt    DateTime                    @default(now()) @db.Timestamptz(3)
  entries      CommissionSettlementEntry[]

  @@index([restaurantId, createdAt])
}

model CommissionSettlementEntry {
  settlementId String
  settlement   CommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  entryId      String               @unique
  entry        CommissionEntry      @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@id([settlementId, entryId])
}

/// The administrator excuses the platform fee of one delivered order (owner decision 2026-11-05, e.g. the owner's own order). Append-only; the ledger entry is
/// NOT changed: every balance, payout and statement skips an entry that has a waiver.
model CommissionWaiver {
  id           String          @id @default(cuid())
  entryId      String          @unique
  entry        CommissionEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  amountSom    Int
  reason       String
  waivedBy     String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([restaurantId, createdAt])
}

/// Stage 8C: append-only audit of administrator actions (restaurant suspend/resume).
model AdminAuditEvent {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetType, targetId, createdAt])
}

/// Admin app (DS Admin): one-time sign-in code sent through the customer bot to a SUPPORT_ADMIN_* Telegram account.
/// Only a hash of the code is stored; a code works once, for a few minutes, with a few tries.
model AdminLoginCode {
  id             String    @id @default(cuid())
  telegramUserId String
  codeHash       String
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  usedAt         DateTime? @db.Timestamptz(3)

  @@index([telegramUserId, createdAt])
}

/// Admin app device session (token hash only, revocable like RestaurantSession). Access also needs the Telegram id to still be a support admin.
model AdminSession {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  telegramUserId String
  deviceName     String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  revokedReason  String?

  @@index([telegramUserId, revokedAt, expiresAt])
}

/// Admin sign-in throttling. keyHash = sha256 of "tg:<id>" or "ip:<ip>"; kind = CODE_REQUEST | VERIFY. No raw identifiers are stored.
model AdminAuthAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  kind      String
  success   Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([keyHash, kind, createdAt])
  @@index([createdAt])
}

/// Admin app "Diqqat": the administrator pressed "called" on an attention item; its alarm stays quiet until snoozeUntil
/// (then rings again if the problem is still open). key = "<KIND>:<id>" of the item, see modules/admin-attention.
model AdminAttentionAck {
  key         String   @id
  ackedBy     String
  ackedAt     DateTime @default(now()) @db.Timestamptz(3)
  snoozeUntil DateTime @db.Timestamptz(3)

  @@index([snoozeUntil])
}

model CommissionEvent {
  id        String          @id @default(cuid())
  entryId   String
  entry     CommissionEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  actorId   String
  actorType String
  action    String
  details   Json?
  createdAt DateTime        @default(now()) @db.Timestamptz(3)

  @@index([entryId, createdAt])
}

/// Stage 6E: one row per logical notification (event + recipient chat). The unique key makes duplicate sends impossible
/// across workers, retries and restarts; `sentAt` marks a delivered message, `claimedAt` is a short send lease.
model NotificationLog {
  id                String    @id @default(cuid())
  dedupeKey         String    @unique
  kind              String
  chatId            String
  orderId           String?
  attempts          Int       @default(0)
  claimedAt         DateTime? @db.Timestamptz(3)
  sentAt            DateTime? @db.Timestamptz(3)
  telegramMessageId Int?
  lastError         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

/// Stage 9: a few platform-wide switches an administrator flips from Telegram (audited in AdminAuditEvent). Absent row = the safe default.
model PlatformSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// A customer's rating of the food/restaurant for one delivered order (24 h to give or change it after delivery). reasons: tags for 1-3 stars;
// note: optional, visible to the restaurant and the platform admins only.
model OrderRating {
  id           String     @id @default(cuid())
  orderId      String     @unique
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  stars        Int
  reasons      String[]   @default([])
  note         String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  @@index([restaurantId, createdAt])
}

// The restaurant's photo shown on its card (set by a platform admin in Telegram). Bytes live in the database; version busts the browser cache.
/// A dish photo set by the restaurant from its app; stored in the database like RestaurantImage. imageUrl on Product stays for legacy external links.
model ProductImage {
  productId String   @id
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  sha256    String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// A category photo set by the restaurant from its app; the customer menu opens on a grid of categories.
model CategoryImage {
  categoryId String   @id
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mime       String
  data       Bytes
  sha256     String
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
}

model RestaurantImage {
  restaurantId String     @id
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  mime         String
  data         Bytes
  sha256       String
  version      Int        @default(1)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)
}

/// Owner decision 2026-10-30: a customer who did not receive an order gets a strike; one active strike turns cash off for them, five block them.
/// Strikes are never deleted: an administrator revokes one with a note (revokedAt). source: ADMIN | RESTAURANT | TAXI. The partial unique index
/// "one strike per order and source" lives in the migration SQL.
model CustomerStrike {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId    String?
  order      Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  source     String
  reportedBy String
  note       String
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  revokedBy  String?
  revokeNote String?

  @@index([customerId, revokedAt])
}

/// Owner's own record that he transferred a restaurant's daily payout (admin app, "To'lov hisoboti"). The platform never moves money: this only
/// remembers WHAT was paid for which Tashkent day so it is not paid twice. One live mark per restaurant and day (partial unique index in the
/// migration SQL); "unmark" sets revokedAt, the row stays.
model PayoutMark {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  day          String
  amountSom    Int
  markedBy     String
  note         String?
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime?  @db.Timestamptz(3)
  revokedBy    String?
  revokeNote   String?

  @@index([restaurantId, day])
}

/// A "1+1" offer of one restaurant (owner decision 2026-11-01): of every two units of its products the cheaper one is free, paid by the restaurant.
/// Off until an administrator switches it on (isActive); it never has an end date, an optional cap per order may be set.
model Promotion {
  id              String             @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant         @relation(fields: [restaurantId], references: [id])
  title           String
  kind            String             @default("BUY1_GET1")
  isActive        Boolean            @default(false)
  maxFreePerOrder Int?
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  products        PromotionProduct[]
  banners         Banner[]

  @@index([restaurantId, isActive])
}

model PromotionProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

/// A slide in the Mini App's home carousel (news / offers). Tapping it opens the restaurant (and, for a promotion, its "Chegirmalar" group).
/// Shown only while isActive, inside startsAt..endsAt when set, and (when linked to a promotion) while that promotion is on.
model Banner {
  id           String       @id @default(cuid())
  title        String
  position     Int          @default(0)
  isActive     Boolean      @default(true)
  startsAt     DateTime?    @db.Timestamptz(3)
  endsAt       DateTime?    @db.Timestamptz(3)
  restaurantId String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  promotionId  String?
  promotion    Promotion?   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  image        BannerImage?

  @@index([isActive, position])
}

model BannerImage {
  bannerId  String   @id
  banner    Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  sha256    String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
