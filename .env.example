# Create a NEW PostgreSQL database named ds_delivery (do NOT point at ds_payment_v3)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ds_delivery?schema=public"
PORT=4000
HOST=127.0.0.1
# Local-only secret. Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=CHANGE_ME_TO_LONG_RANDOM_VALUE
# Payment engine
PAYMENT_WINDOW_SECONDS=300
QUEUE_WINDOW_SECONDS=600
CARD_COOLDOWN_SECONDS=120
AMBIGUITY_WINDOW_SECONDS=900
MAINTENANCE_SECONDS=5
# Gmail disabled until you've tested and explicitly enabled it
GMAIL_ENABLED=false
GMAIL_FROM=noreply@info.uzcard.uz
GMAIL_POLL_SECONDS=12
GMAIL_LOOKBACK_SECONDS=86400
# Optional: where the OAuth files live (default: next to package.json). On a server use a writable volume, e.g. /app/data/gmail/credentials.json
# and /app/data/gmail/gmail-token.json. The browser consent flow only runs at a terminal; a server without a token refuses to start Gmail.
# GMAIL_CREDENTIALS_FILE=
# GMAIL_TOKEN_FILE=

# Humocard bot messages as a faster payment signal (src/modules/payment/humo-telegram.ts). Off by default.
# api_id / api_hash: https://my.telegram.org -> API development tools. The session is made once with `npm run humo:login` in your own terminal and
# kept in humo-session.txt (private, git-ignored) or HUMO_TG_SESSION. It is a full login of that Telegram account: treat it like a password.
HUMO_TG_ENABLED=false
# HUMO_TG_API_ID=
# HUMO_TG_API_HASH=
# HUMO_TG_BOT=            # the Humocard bot username, without @
# HUMO_TG_SESSION_FILE=   # default ./humo-session.txt
# HUMO_TG_POLL_SECONDS=30
# An exact Humocard match confirms itself and starts cooking (like the e-mail one). HUMO_AUTO_CONFIRM=false = the restaurant confirms in the app.
# HUMO_AUTO_CONFIRM=true
# HUMO_TG_LOOKBACK_SECONDS=1800

# Client Telegram bot — local polling only. Never commit the token.
BOT_ENABLED=false
BOT_TOKEN=

# Telegram checkout is MOCK by default: no money should be transferred.
BOT_PAYMENT_MODE=MOCK
# REAL mode additionally requires GMAIL_ENABLED=true, real card(s) for each restaurant,
# and a mapping of last4 to a 16-digit payee card number. Do NOT enable without
# explicit restaurant permission and bank approval.
# BOT_REAL_CARD_NUMBERS_JSON='{"8167":"REPLACE_WITH_REAL_16_DIGITS"}'

# Taxi operator — v0.5 (DB-backed scheduler)
TAXI_LEAD_MINUTES=4
TAXI_OPERATOR_RESPONSE_SECONDS=180
TAXI_WORKER_INTERVAL_SECONDS=5
# Optional: bot must have received /start from this Telegram user
# TAXI_ALERT_TELEGRAM_ID=123456789

# Support tickets — Stage 3B. Two equal administrators; each must send /start to the bot first.
# Get an ID with /myid. Without at least one ID, /support reports "unavailable".
# SUPPORT_ADMIN_1_TELEGRAM_ID=123456789
# SUPPORT_ADMIN_2_TELEGRAM_ID=987654321
# SUPPORT_WORKER_INTERVAL_SECONDS=5

# Restaurant acceptance before payment - Stage 4B-1
# REAL orders always wait for the restaurant. Seconds the restaurant has to accept/reject (30-86400).
# RESTAURANT_RESPONSE_SECONDS=600
# Opt MOCK orders into the same flow (default false keeps the legacy immediate mock payment).
# RESTAURANT_ACCEPTANCE_MOCK=false

# Restaurant API authentication - Stage 5A (all optional; defaults shown). Requires Node.js >= 24.7 (built-in Argon2id).
# RESTAURANT_SESSION_HOURS=4320   # sliding: signed in until logout; expires only after this many hours WITHOUT use
# RESTAURANT_MAX_SESSIONS=10
# RESTAURANT_LOGIN_MAX_FAILURES=5
# RESTAURANT_LOGIN_IP_MAX_FAILURES=30
# RESTAURANT_LOGIN_WINDOW_MINUTES=15
# Provisioning passwords: use `npm run restaurant:password -- <slug>` (hidden prompt). Never put passwords in .env.
# Stage 6B: flat platform commission in som per genuinely delivered order (integer 1..1000000). Stored per ledger entry when accrued.
# COMMISSION_FLAT_SOM=5000

# Customer Android app (Capacitor APK) - see docs/CUSTOMER_ANDROID_MVP.md. Needs MINIAPP_ENABLED=true too.
# Guest sessions (the app opens without registration). OFF by default: bootstrap and Bearer sessions answer 404 until enabled.
# ANDROID_GUEST_ENABLED=false
# GUEST_SESSION_DAYS=180
# GUEST_BOOTSTRAP_PER_IP_HOUR=20
# Optional Telegram link: the bot username used to build https://t.me/<bot>?start=lnk_<token> (defaults to the customer bot's own username)
# BOT_USERNAME=
# TELEGRAM_LINK_TTL_MINUTES=10

# DS Admin app (A0: sign-in only). OFF (404) unless true. Sign-in code goes to a SUPPORT_ADMIN_*_TELEGRAM_ID through the customer bot.
# ADMIN_APP_ENABLED=false
# ADMIN_CODE_MINUTES=5
# ADMIN_CODE_MAX_TRIES=5
# ADMIN_CODE_REQUESTS_PER_ID=5
# ADMIN_CODE_REQUESTS_PER_IP=20
# ADMIN_VERIFY_MAX_FAILURES=10
# ADMIN_VERIFY_IP_MAX_FAILURES=30
# ADMIN_LOGIN_WINDOW_MINUTES=15
# ADMIN_SESSION_DAYS=90      # sliding: expires only after this many days WITHOUT use
# ADMIN_MAX_SESSIONS=5
# DS Admin "Diqqat" (A1): seconds an item must be open before it is raised, and the Telegram copy (kill switch).
# ADMIN_ATTN_UNSEEN_SECONDS=120        # paid order the kitchen has not acknowledged
# ADMIN_ATTN_CASH_SECONDS=180          # cash order nobody accepted
# ADMIN_ATTN_OFFLINE_SECONDS=180       # restaurant app silent while something waits for it (min 120)
# ADMIN_ATTN_UNVERIFIED_SECONDS=180    # payment matched but not confirmed
# ADMIN_ATTN_READY_NO_TAXI_SECONDS=300
# ADMIN_ATTN_NOT_DELIVERED_SECONDS=3600
# ADMIN_ATTN_TICKET_SECONDS=600
# ADMIN_ATTN_SNOOZE_MINUTES=15         # how long "I called" keeps an item quiet
# ADMIN_ATTENTION_TELEGRAM=true        # false = no Telegram copy of the Diqqat items
# ADMIN_ATTENTION_INTERVAL_SECONDS=15
