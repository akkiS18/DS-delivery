<UserControl x:Class="DsRestaurant.App.Views.FinanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DsRestaurant.App.ViewModels"
        xmlns:controls="clr-namespace:DsRestaurant.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:FinanceViewModel}"
             Background="#0F172A"
             Focusable="True"
             KeyDown="FinanceView_KeyDown">

    <Grid Margin="24">
        <!-- 1. CHECKING PHASE -->
        <Grid Visibility="{Binding Phase, Converter={x:Static vm:FinancePhaseToVisibilityConverter.Instance}, ConverterParameter=Checking}">
            <Border Background="#1E293B" CornerRadius="12" Padding="32" BorderBrush="#334155" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <controls:Icon Data="{StaticResource Ic.Refresh}" Width="40" Height="40" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Moliya holati tekshirilmoqda..." FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. NO PIN PHASE -->
        <Grid Visibility="{Binding Phase, Converter={x:Static vm:FinancePhaseToVisibilityConverter.Instance}, ConverterParameter=NoPin}">
            <Border Background="#1E293B" CornerRadius="12" Padding="36" BorderBrush="#334155" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480">
                <StackPanel HorizontalAlignment="Center">
                    <controls:Icon Data="{StaticResource Ic.Lock}" Width="52" Height="52" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16" />
                    <TextBlock Text="Moliya kodi belgilanmagan" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Restoran moliya va hisobotlar bo‘limini ochish uchun administrator tomonidan 4 xonali PIN-kod biriktirilishi kerak. Iltimos, ma'muriyat bilan bog‘laning."
                               FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" LineHeight="20" Margin="0,0,0,20" />
                    <Button Content="Qayta tekshirish" Command="{Binding RefreshCommand}" Height="38" Padding="20,0"
                            HorizontalAlignment="Center" Background="#0284C7" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. LOCKED PHASE: PIN CODE PAD -->
        <Grid Visibility="{Binding Phase, Converter={x:Static vm:FinancePhaseToVisibilityConverter.Instance}, ConverterParameter=Locked}">
            <Border Background="#1E293B" CornerRadius="16" Padding="36" BorderBrush="#334155" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <StackPanel HorizontalAlignment="Center">
                    <!-- Lock Icon & Header -->
                    <controls:Icon Data="{StaticResource Ic.Lock}" Width="40" Height="40" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Moliya kodi" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                    <TextBlock Text="4 xonali kodni kiriting" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,20" />

                    <!-- PIN Indicator (4 Dots) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="16" Height="16" CornerRadius="8" Margin="8,0"
                                Background="{Binding Dot1Filled, Converter={x:Static vm:DotToColorConverter.Instance}}" />
                        <Border Width="16" Height="16" CornerRadius="8" Margin="8,0"
                                Background="{Binding Dot2Filled, Converter={x:Static vm:DotToColorConverter.Instance}}" />
                        <Border Width="16" Height="16" CornerRadius="8" Margin="8,0"
                                Background="{Binding Dot3Filled, Converter={x:Static vm:DotToColorConverter.Instance}}" />
                        <Border Width="16" Height="16" CornerRadius="8" Margin="8,0"
                                Background="{Binding Dot4Filled, Converter={x:Static vm:DotToColorConverter.Instance}}" />
                    </StackPanel>

                    <!-- Error or Blocked Banner -->
                    <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,16"
                            Visibility="{Binding PinError, Converter={x:Static vm:StringNullOrEmptyToVisibilityConverter.Instance}}">
                        <TextBlock Text="{Binding PinError}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" FontWeight="SemiBold" />
                    </Border>

                    <!-- 3x4 Keypad Grid -->
                    <Grid Width="240" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="56" />
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: 1, 2, 3 -->
                        <Button Grid.Row="0" Grid.Column="0" Content="1" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="0" Grid.Column="1" Content="2" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="0" Grid.Column="2" Content="3" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />

                        <!-- Row 1: 4, 5, 6 -->
                        <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />

                        <!-- Row 2: 7, 8, 9 -->
                        <Button Grid.Row="2" Grid.Column="0" Content="7" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="2" Grid.Column="1" Content="8" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="2" Grid.Column="2" Content="9" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />

                        <!-- Row 3: Clear, 0, Backspace -->
                        <Button Grid.Row="3" Grid.Column="0" Content="C" Style="{StaticResource PinButtonStyle}" Command="{Binding ClearPinCommand}" />
                        <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource PinButtonStyle}" Click="KeypadDigit_Click" />
                        <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource PinButtonStyle}" Command="{Binding BackspaceCommand}" ToolTip="O‘chirish" AutomationProperties.Name="O‘chirish"><controls:Icon Data="{StaticResource Ic.Backspace}" Width="24" Height="24" /></Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. OPEN PHASE -->
        <Grid Visibility="{Binding Phase, Converter={x:Static vm:FinancePhaseToVisibilityConverter.Instance}, ConverterParameter=Open}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Moliya va Hisobotlar" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Refresh}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Yangilash" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Command="{Binding LockCommand}" Style="{StaticResource TabButtonStyle}"><StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Lock}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Qulflash" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
            </Grid>

            <!-- CONTENT: OVERVIEW OR JAMI LEDGER -->
            <Grid Grid.Row="1">
                <!-- VIEW A: OVERVIEW (CARD MONEY ONLY) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HistoryOpen, Converter={x:Static vm:InverseBooleanToVisibilityConverter.Instance}}">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <!-- Open Refunds Warning -->
                        <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16"
                                Visibility="{Binding HasOpenRefunds, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:Icon Data="{StaticResource Ic.Warning}" Width="18" Height="18" Foreground="#FBBF24" Margin="0,0,8,0" />
                                <TextBlock Text="Qaytarish so‘rovi mavjud: " FontWeight="Bold" Foreground="#FDE68A" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OpenRefundsCount, StringFormat='{}{0} ta'}" FontWeight="Bold" Foreground="#FDE68A" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding OpenRefundsAmountText, StringFormat='({0})'}" Foreground="#FCD34D" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- PLATFORM CARD BLOCK -->
                        <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16"
                                Visibility="{Binding HasPlatformCard, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Card}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#38BDF8" /><TextBlock Text="Platforma kartasi" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" /></StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Sizga qoldi" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PlatformRemainingText}" FontSize="32" FontWeight="ExtraBold" Foreground="#22C55E" Margin="0,0,0,16" />

                                <!-- Progress Bar -->
                                <Border Background="#0F172A" Height="10" CornerRadius="5" Margin="0,0,0,16">
                                    <Grid HorizontalAlignment="Left">
                                        <Border Background="#16A34A" Height="10" CornerRadius="5"
                                                Width="{Binding PlatformProgressRatio, Converter={x:Static vm:RatioToPercentWidthConverter.Instance}, ConverterParameter=750}" />
                                    </Grid>
                                </Border>

                                <!-- Details Grid -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Siz ishlab topdingiz" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding PlatformEarnedText}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Platforma ishlab topdi" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding PlatformFeeText}" FontSize="15" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sizga to‘lab berildi" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding PlatformPaidOutText}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- OWN CARD BLOCK -->
                        <Border Background="#1E293B" CornerRadius="14" Padding="24" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20"
                                Visibility="{Binding HasOwnCard, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Card}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#F59E0B" /><TextBlock Text="O‘z kartangiz" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" /></StackPanel>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="Platformaga to‘lash kerak" FontSize="14" Foreground="#94A3B8" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding OwnFeeRemainingText}" FontSize="32" FontWeight="ExtraBold" Foreground="#F59E0B" Margin="0,0,0,16" />

                                <!-- Progress Bar -->
                                <Border Background="#0F172A" Height="10" CornerRadius="5" Margin="0,0,0,16">
                                    <Grid HorizontalAlignment="Left">
                                        <Border Background="#D97706" Height="10" CornerRadius="5"
                                                Width="{Binding OwnProgressRatio, Converter={x:Static vm:RatioToPercentWidthConverter.Instance}, ConverterParameter=750}" />
                                    </Grid>
                                </Border>

                                <!-- Details Grid -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Siz ishlab topdingiz" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding OwnEarnedText}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Platforma komissiyasi" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding OwnFeeText}" FontSize="15" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Platformaga to‘landi" FontSize="12" Foreground="#94A3B8" />
                                        <TextBlock Text="{Binding OwnSettledText}" FontSize="15" FontWeight="Bold" Foreground="#22C55E" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- BIG JAMI BUTTON -->
                        <Button Command="{Binding OpenHistoryCommand}" Height="48" Padding="24,0"
                                HorizontalAlignment="Left" Background="#0284C7" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10" />
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon Data="{StaticResource Ic.Receipt}" Width="18" Height="18" Margin="0,0,8,0" /><TextBlock Text="Jami tushumlar va hisobotlar" VerticalAlignment="Center" />
                                <controls:Icon Data="{StaticResource Ic.ArrowRight}" Width="16" Height="16" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW B: JAMI HISTORY LEDGER -->
                <Grid Visibility="{Binding HistoryOpen, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Back Button & History Filters -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CloseHistoryCommand}" Style="{StaticResource TabButtonStyle}" Margin="0,0,16,0"><StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.ArrowLeft}" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="Ortga" VerticalAlignment="Center" /></StackPanel></Button>
                            <TextBlock Text="Jami tushumlar tarixi" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Filters: Periods & Sources -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Period Chips -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Button Content="Hammasi" Command="{Binding SelectPeriodCommand}" CommandParameter="All" Style="{StaticResource TabButtonStyle}" Margin="0,0,4,0" />
                                <Button Content="Bugun" Command="{Binding SelectPeriodCommand}" CommandParameter="Today" Style="{StaticResource TabButtonStyle}" Margin="0,0,4,0" />
                                <Button Content="7 kun" Command="{Binding SelectPeriodCommand}" CommandParameter="Last7Days" Style="{StaticResource TabButtonStyle}" Margin="0,0,4,0" />
                                <Button Content="Shu oy" Command="{Binding SelectPeriodCommand}" CommandParameter="ThisMonth" Style="{StaticResource TabButtonStyle}" />
                            </StackPanel>

                            <!-- Source Chips -->
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Barchasi" Command="{Binding SelectSourceCommand}" CommandParameter="All" Style="{StaticResource TabButtonStyle}" Margin="0,0,4,0" />
                                <Button Content="Karta" Command="{Binding SelectSourceCommand}" CommandParameter="Card" Style="{StaticResource TabButtonStyle}" Margin="0,0,4,0" />
                                <Button Content="Naqd" Command="{Binding SelectSourceCommand}" CommandParameter="Cash" Style="{StaticResource TabButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Totals Summary Card -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Siz ishlab topdingiz" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding TotalsEarnedText}" FontSize="24" FontWeight="ExtraBold" Foreground="#22C55E" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Buyurtmalar" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding TotalsOrdersCount, StringFormat='{}{0} ta'}" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="Platforma ulushi" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding TotalsFeeText}" FontSize="16" FontWeight="Bold" Foreground="#CBD5E1" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                        Visibility="{Binding HasPaidOut, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                <TextBlock Text="To‘lab berildi" FontSize="12" Foreground="#94A3B8" />
                                <TextBlock Text="{Binding TotalsPaidOutText}" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Items List or Empty Notice -->
                    <Grid Grid.Row="2">
                        <!-- Loading Indicator -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsLedgerLoading, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                            <TextBlock Text="Yuklanmoqda..." Foreground="#94A3B8" FontSize="14" />
                        </Border>

                        <!-- Items ScrollViewer -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding LedgerItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1E293B" CornerRadius="8" Padding="14,12" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Order info or Payout info -->
                                                    <StackPanel Grid.Column="0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding OrderCode, StringFormat='Buyurtma #{0}'}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0"
                                                                       Visibility="{Binding OrderCode, Converter={x:Static vm:StringNullOrEmptyToVisibilityConverter.Instance}}" />
                                                            <TextBlock Text="{Binding Kind, Converter={x:Static vm:LedgerKindToTitleConverter.Instance}}"
                                                                       FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0"
                                                                       Visibility="{Binding OrderCode, Converter={x:Static vm:NullToVisibilityConverter.Instance}}" />
                                                            <Border Background="#0F172A" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding Source, Converter={x:Static vm:LedgerSourceToTextConverter.Instance}}"
                                                                           FontSize="11" Foreground="#94A3B8" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding At}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
                                                    </StackPanel>

                                                    <!-- Right: Amounts -->
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding RestaurantShareSom, Converter={x:Static vm:LongToSignedSomConverter.Instance}}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Right"
                                                                   Visibility="{Binding RestaurantShareSom, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}" />
                                                        <TextBlock Text="{Binding AmountSom, Converter={x:Static vm:LongToSignedSomConverter.Instance}}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"
                                                                   Visibility="{Binding AmountSom, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}" />
                                                        <TextBlock Text="{Binding PlatformFeeSom, StringFormat='Platforma: −{0} so‘m'}"
                                                                   FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                                   Visibility="{Binding PlatformFeeSom, Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Load More Button -->
                                <Button Content="Yana yuklash" Command="{Binding LoadMoreLedgerCommand}" Height="38" Margin="0,8,0,16"
                                        Background="#334155" BorderThickness="0" Foreground="#F8FAFC" FontWeight="SemiBold" Cursor="Hand"
                                        Visibility="{Binding HasNextCursor, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
