<UserControl x:Class="DsRestaurant.App.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DsRestaurant.App.ViewModels"
        xmlns:controls="clr-namespace:DsRestaurant.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ReservationsViewModel}"
             Background="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: TITLE & REFRESH -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Bronlar (Stol band qilish)" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding LoadReservationsCommand}" Style="{StaticResource TabButtonStyle}"><StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Refresh}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBlock Text="Yangilash" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
        </Grid>

        <!-- SETTINGS CARD -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsReservationsEnabled}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" Cursor="Hand">
                        <TextBlock Text="Mijozlar uchun stol bron qilishni yoqish" Foreground="#F8FAFC" />
                    </CheckBox>
                    <TextBlock Text="Mijoz bron qilganda karta orqali depozit to‘laydi." Foreground="#94A3B8" FontSize="12" Margin="24,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Depozit summasi:" Foreground="#CBD5E1" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DepositSom, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="36"
                             Background="#0F172A" Foreground="#22C55E" FontWeight="Bold" BorderBrush="#475569" BorderThickness="1"
                             Padding="8,4" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,12,0" />
                    <Button Content="Saqlash" Command="{Binding SaveSettingsCommand}" Height="36" Padding="14,0"
                            Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESERVATIONS LIST -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Kutilayotgan bronlar" Foreground="#CBD5E1" FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

                <!-- Empty state -->
                <TextBlock Text="Hozircha kutilayotgan bronlar yo‘q." Foreground="#64748B" FontSize="13" Margin="0,0,0,16"
                           Visibility="{Binding Upcoming.Count, Converter={x:Static vm:ZeroToVisibilityConverter.Instance}}" />

                <!-- Upcoming cards -->
                <ItemsControl ItemsSource="{Binding Upcoming}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left details -->
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding Code, StringFormat='#{0}'}" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" />
                                            <Border Background="#16A34A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PartySize, StringFormat='{}{0} kishi'}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center"><controls:Icon Data="{StaticResource Ic.Clock}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#38BDF8" /><TextBlock Text="{Binding StartsAt}" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding CustomerName}" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding CustomerPhone, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="13" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Note, StringFormat='Izoh: {0}'}" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"
                                                   Visibility="{Binding Note, Converter={x:Static vm:StringNullOrEmptyToVisibilityConverter.Instance}}" />
                                    </StackPanel>

                                    <!-- Right Actions -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Ko‘rildi" Click="MarkSeen_Click" Height="34" Padding="12,0" Margin="0,0,8,0"
                                                Background="#334155" BorderThickness="0" Foreground="#F8FAFC" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="To‘lov keldi" Click="ConfirmPayment_Click" Height="34" Padding="12,0" Margin="0,0,8,0"
                                                Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand"
                                                Visibility="{Binding AwaitingConfirm, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="Bekor qilish" Click="Cancel_Click" Height="34" Padding="12,0"
                                                Background="#DC2626" BorderThickness="0" Foreground="#FFFFFF" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
