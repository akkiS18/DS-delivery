<UserControl x:Class="DsRestaurant.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DsRestaurant.App.ViewModels"
        xmlns:controls="clr-namespace:DsRestaurant.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             Background="#0F172A">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Sozlamalar" FontSize="24" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,6" />
            <TextBlock Text="Dastur va bildirishnoma parametrlari" FontSize="13" Foreground="#94A3B8" Margin="0,0,0,24" />

            <!-- Success / Info Message -->
            <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding Message, Converter={x:Static vm:StringNullOrEmptyToVisibilityConverter.Instance}}">
                <TextBlock Text="{Binding Message}" Foreground="#A7F3D0" FontSize="13" />
            </Border>

            <!-- Operations / Work Schedule Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><controls:Icon Data="{StaticResource Ic.Store}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#F8FAFC" /><TextBlock Text="Ish tartibi va faollik holati" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="Buyurtmalar qabulini boshqarish va haftalik ish jadvali." Foreground="#94A3B8" FontSize="13" Margin="0,0,0,16" />

                    <!-- Pause / Active Switch -->
                    <Border Background="#0F172A" CornerRadius="10" Padding="14" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Buyurtmalar qabuli:" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding IsPaused, Converter={x:Static vm:BooleanToPausedStatusTextConverter.Instance}}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="{Binding IsPaused, Converter={x:Static vm:BooleanToPausedStatusColorConverter.Instance}}" />
                                </StackPanel>
                                <TextBlock Text="Pauza holatida mijozlar yangi buyurtma yubora olmaydi." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
                            </StackPanel>

                            <Button Grid.Column="1" Command="{Binding ToggleStatusCommand}" Height="36" Padding="14,0"
                                    Background="{Binding IsPaused, Converter={x:Static vm:BooleanToPausedButtonBackgroundConverter.Instance}}"
                                    Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Button.Resources>
                                <TextBlock Text="{Binding IsPaused, Converter={x:Static vm:BooleanToPausedButtonTextConverter.Instance}}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Separator Background="#334155" Margin="0,0,0,14" />

                    <!-- Weekly Working Hours -->
                    <TextBlock Text="Haftalik ish jadvali" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding WorkingDays}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding DayName}" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center" />
                                    
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOpen}" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" Cursor="Hand">
                                        <TextBlock Text="Ochiq" Foreground="#94A3B8" />
                                    </CheckBox>

                                    <TextBox Grid.Column="2" Text="{Binding OpenTime, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsOpen}" Height="28" Background="#0F172A" Foreground="#F8FAFC"
                                             BorderBrush="#475569" BorderThickness="1" HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="12" />

                                    <TextBlock Grid.Column="3" Text="—" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBox Grid.Column="4" Text="{Binding CloseTime, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsOpen}" Height="28" Background="#0F172A" Foreground="#F8FAFC"
                                             BorderBrush="#475569" BorderThickness="1" HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="Jadvalni saqlash" Command="{Binding SaveWorkingHoursCommand}" Height="36" Padding="16,0"
                            HorizontalAlignment="Left" Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Payee Cards Management Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><controls:Icon Data="{StaticResource Ic.Card}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#F8FAFC" /><TextBlock Text="To‘lov kartalari (Restoran hisobi)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="Platformadan tushgan mablag‘lar o‘tkazib beriladigan restoran bank kartalari." Foreground="#94A3B8" FontSize="13" Margin="0,0,0,14" />

                    <!-- Cards List -->
                    <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Horizontal"><controls:Icon Data="{StaticResource Ic.Card}" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" /><TextBlock Text="" FontSize="14" VerticalAlignment="Center" /></StackPanel>
                                                <TextBlock Text="{Binding CardNumber}" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,10,0" />
                                                <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding CardType}" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold" />
                                                </Border>
                                                <!-- IsActive status -->
                                                <Border Background="{Binding IsActive, Converter={x:Static vm:CardStatusBackgroundConverter.Instance}}"
                                                        CornerRadius="6" Padding="6,2">
                                                    <TextBlock Text="{Binding IsActive, Converter={x:Static vm:CardStatusTextConverter.Instance}}"
                                                               FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CardHolder}" FontSize="12" Foreground="#94A3B8" Margin="22,4,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Enable Button if not active -->
                                            <Button Content="Yoqish" Command="{Binding DataContext.EnableCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" Height="30" Padding="10,0" Margin="0,0,6,0"
                                                    Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding IsActive, Converter={x:Static vm:InverseBooleanToVisibilityConverter.Instance}}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                            <!-- Disable Button if active -->
                                            <Button Content="O‘chirish" Command="{Binding DataContext.DisableCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" Height="30" Padding="10,0"
                                                    Background="#EF4444" BorderThickness="0" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                                                    Visibility="{Binding IsActive, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="6" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add Card Form -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Yangi karta qo‘shish" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Text="{Binding NewCardNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="8600 0000 0000 0000" Height="36" Margin="0,0,8,0"
                                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                         Padding="10,6" VerticalContentAlignment="Center" FontSize="13" />

                                <TextBox Grid.Column="1" Text="{Binding NewCardHolder, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Karta egasi (F.I.SH)" Height="36" Margin="0,0,8,0"
                                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                                         Padding="10,6" VerticalContentAlignment="Center" FontSize="13" />

                                <Button Grid.Column="2" Content="+ Qo‘shish" Command="{Binding AddCardCommand}"
                                        Height="36" Padding="14,0" Background="#0284C7" BorderThickness="0"
                                        Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                            <TextBlock Text="* Karta kiritilgach, xavfsizlik uchun administrator tomonidan tekshirilib tasdiqlanadi." FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sound & Alarm Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><controls:Icon Data="{StaticResource Ic.Volume}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#F8FAFC" /><TextBlock Text="Ovoz va bildirishnomalar" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" /></StackPanel>
                    <TextBlock Text="Yangi buyurtma kelganda yangraydigan oshxona qo‘ng‘irog‘ini tekshirish." Foreground="#94A3B8" FontSize="13" Margin="0,0,0,14" />

                    <Button Content="Ovozni sinash (Ring test)" Command="{Binding TestSoundCommand}" Height="40" Width="200"
                            HorizontalAlignment="Left" Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!-- System Behavior Card -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><controls:Icon Data="{StaticResource Ic.Monitor}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#F8FAFC" /><TextBlock Text="Tizim sozlamalari" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" /></StackPanel>

                    <!-- Autostart Checkbox -->
                    <CheckBox IsChecked="{Binding IsAutostartEnabled}" Command="{Binding ToggleAutostartCommand}"
                              Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,12" Cursor="Hand">
                        <TextBlock Text="Windows bilan birga avtomatik ishga tushsin" Foreground="#F8FAFC" />
                    </CheckBox>

                    <!-- Tray minimize Checkbox -->
                    <CheckBox IsChecked="{Binding HideToTrayOnClose}"
                              Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,16" Cursor="Hand">
                        <TextBlock Text="Dastur yopilganda (X) to‘xtamasdan trayga yashirilsin" Foreground="#F8FAFC" />
                    </CheckBox>

                    <!-- Open Logs Folder -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Log fayllari papkasini ochish" Command="{Binding OpenLogsFolderCommand}"
                                Height="36" Padding="14,0" Background="#334155" BorderThickness="0" Foreground="#F8FAFC" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About & Logout -->
            <Border Background="#1E293B" CornerRadius="12" Padding="20" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DS Restaurant for Windows" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="{Binding Version, StringFormat='Versiya {0}'}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="Chiqish (Logout)" Command="{Binding LogoutCommand}"
                            Height="38" Width="140" HorizontalAlignment="Right" Background="#DC2626" BorderThickness="0"
                            Foreground="#FFFFFF" FontWeight="Bold" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
