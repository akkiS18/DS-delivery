<UserControl x:Class="DsRestaurant.App.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DsRestaurant.App.ViewModels"
             xmlns:controls="clr-namespace:DsRestaurant.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:OrdersViewModel}"
             Background="#0F172A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: TABS & SILENCE BANNER. The open tab is solid green. -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <!-- Tabs -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Yangi -->
                    <Button Style="{StaticResource TabButtonStyle}" Click="Tab_Click" Tag="new" Margin="0,0,8,0"
                            controls:Ui.IsActive="{Binding SelectedTab, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=new}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Yangi" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#EF4444" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Margin="8,0,0,0"
                                    Visibility="{Binding NewCount, Converter={x:Static vm:CountToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding NewCount}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tayyorlanmoqda -->
                    <Button Style="{StaticResource TabButtonStyle}" Click="Tab_Click" Tag="cooking" Margin="0,0,8,0"
                            controls:Ui.IsActive="{Binding SelectedTab, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=cooking}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tayyorlanmoqda" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#F59E0B" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Margin="8,0,0,0"
                                    Visibility="{Binding CookingCount, Converter={x:Static vm:CountToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding CookingCount}" Foreground="#000000" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tayyor -->
                    <Button Style="{StaticResource TabButtonStyle}" Click="Tab_Click" Tag="ready" Margin="0,0,8,0"
                            controls:Ui.IsActive="{Binding SelectedTab, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=ready}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Tayyor" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#22C55E" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Margin="8,0,0,0"
                                    Visibility="{Binding ReadyCount, Converter={x:Static vm:CountToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding ReadyCount}" Foreground="#052E16" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Kutilmoqda -->
                    <Button Style="{StaticResource TabButtonStyle}" Click="Tab_Click" Tag="waiting" Margin="0,0,8,0"
                            controls:Ui.IsActive="{Binding SelectedTab, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=waiting}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kutilmoqda" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Background="#64748B" CornerRadius="10" MinWidth="22" Height="22" Padding="6,0" Margin="8,0,0,0"
                                    Visibility="{Binding WaitingCount, Converter={x:Static vm:CountToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding WaitingCount}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Tarix -->
                    <Button Style="{StaticResource TabButtonStyle}" Click="Tab_Click" Tag="history"
                            controls:Ui.IsActive="{Binding SelectedTab, Converter={x:Static vm:EqualsConverter.Instance}, ConverterParameter=history}">
                        <TextBlock Text="Tarix" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Right Action Bar: Silence bell & Refresh -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Silence Button (Prominent when Ringing) -->
                    <Button Command="{Binding SilenceCommand}" Height="38" Padding="14,0" Margin="0,0,12,0"
                            Background="#DC2626" BorderThickness="0" Cursor="Hand" Foreground="#FFFFFF"
                            Visibility="{Binding IsRinging, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Data="{StaticResource Ic.BellOff}" Width="18" Height="18" Margin="0,0,8,0" />
                            <TextBlock Text="Ovozni o‘chirish (30 s)" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Yangilash" AutomationProperties.Name="Yangilash">
                        <controls:Icon Data="{StaticResource Ic.Refresh}" Width="18" Height="18" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN MASTER-DETAIL WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: ORDERS LIST -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Empty list state -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding Orders.Count, Converter={x:Static vm:ZeroToVisibilityConverter.Instance}}">
                        <controls:Icon Data="{StaticResource Ic.Inbox}" Width="44" Height="44" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Hozircha buyurtma yo‘q" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Orders Cards List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,14,14,20">
                            <ItemsControl ItemsSource="{Binding Orders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:OrderDetailViewModel}">
                                        <Border x:Name="card" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonDown="OrderCard_Click">
                                            <Grid>
                                                <!-- The open order: green bar on the left, green outline, tinted background -->
                                                <Border x:Name="bar" Width="5" HorizontalAlignment="Left" Background="#22C55E" CornerRadius="12,0,0,12" Visibility="Collapsed" />
                                                <Grid Margin="16,14,14,14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Top Row: Code, status & age -->
                                                    <Grid Grid.Row="0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CodeDisplay}" Foreground="#F8FAFC" FontSize="19" FontWeight="Bold" />
                                                            <Border Background="#F59E0B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsTest, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                                                <TextBlock Text="TEST" Foreground="#000000" FontSize="11" FontWeight="Bold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding AgeText}" Foreground="{Binding UrgencyColor}"
                                                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding StatusTitle}" Foreground="#94A3B8" FontSize="13" Margin="0,2,0,0" />

                                                    <!-- What to cook: every dish with its quantity, large, on a green panel -->
                                                    <Border Grid.Row="2" Background="#1F16A34A" BorderBrush="#4016A34A" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding Items}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,3">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Background="#16A34A" CornerRadius="6" MinWidth="40" Padding="8,2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Quantity, StringFormat='{}{0}×'}" Foreground="#FFFFFF" FontSize="17"
                                                                                           FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                                                            </Border>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold"
                                                                                       TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Border Height="1" Background="#4016A34A" Margin="0,8,0,8" />
                                                            <Grid>
                                                                <TextBlock Text="Jami" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding TotalFormatted}" Foreground="#4ADE80" FontSize="21" FontWeight="ExtraBold"
                                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Bottom: payment & delivery badges -->
                                                    <WrapPanel Grid.Row="3" Margin="0,10,0,0">
                                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding PaymentBadge}" Foreground="#CBD5E1" FontSize="12" />
                                                        </Border>
                                                        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                                            <TextBlock Text="{Binding DeliveryBadge}" Foreground="#CBD5E1" FontSize="12" />
                                                        </Border>
                                                    </WrapPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="#22C55E" />
                                                <Setter TargetName="card" Property="Background" Value="#172F27" />
                                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsSelected}" Value="False" />
                                                    <Condition Binding="{Binding IsMouseOver, ElementName=card}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="card" Property="BorderBrush" Value="#64748B" />
                                                <Setter TargetName="card" Property="Background" Value="#243247" />
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Load More Button (Tarix) -->
                            <Button Content="Yana yuklash" Command="{Binding LoadMoreCommand}" Height="40"
                                    Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Foreground="#38BDF8"
                                    Cursor="Hand" Margin="0,8,0,0"
                                    Visibility="{Binding HasMore, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: ORDER DETAIL PANE -->
            <Grid Grid.Column="1" Background="#0F172A">
                <!-- If no order selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding SelectedOrder, Converter={x:Static vm:NullToVisibilityConverter.Instance}}">
                    <controls:Icon Data="{StaticResource Ic.Pointer}" Width="44" Height="44" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Buyurtmani ko‘rish uchun ro‘yxatdan tanlang" Foreground="#94A3B8" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>

                <!-- Order Selected Detail Content -->
                <Grid DataContext="{Binding SelectedOrder}"
                      Visibility="{Binding Converter={x:Static vm:NotNullToVisibilityConverter.Instance}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Order Header -->
                    <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="24,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CodeDisplay}" Foreground="#F8FAFC" FontSize="24" FontWeight="Bold" />
                            <Border Background="{Binding StatusColor}" CornerRadius="6" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusTitle}" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="{Binding AgeText}" Foreground="{Binding UrgencyColor}" FontSize="14" FontWeight="SemiBold"
                                       Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Body: Items Table, Customer, Taxi, Payment -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                        <StackPanel>
                            <!-- Paid and cooking, not yet acknowledged: one tap (no preparation time is asked) -->
                            <Border Background="#1AF59E0B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16"
                                    Visibility="{Binding CanAcknowledge, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}">
                                <StackPanel Orientation="Horizontal">
                                    <controls:Icon Data="{StaticResource Ic.Info}" Foreground="#FBBF24" Margin="0,0,12,0" VerticalAlignment="Top" />
                                    <TextBlock Foreground="#FDE68A" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="560"
                                               Text="To‘lov qabul qilindi. Buyurtmani qabul qiling — shundan keyin mijoz uni bekor qila olmaydi. Tayyorlashni boshlang." />
                                </StackPanel>
                            </Border>

                            <!-- Items: what to cook, large, with quantities -->
                            <Border Background="#1F16A34A" BorderBrush="#4016A34A" CornerRadius="12" Padding="20" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Taomlar ro‘yxati" Foreground="#86EFAC" FontSize="14" FontWeight="Bold" Margin="0,0,0,12" />

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#16A34A" CornerRadius="7" MinWidth="46" Padding="9,3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0}×'}" Foreground="#FFFFFF" FontSize="19"
                                                                   FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"
                                                               TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UnitSom, StringFormat='{}{0:N0} so‘m'}"
                                                               Foreground="#94A3B8" FontSize="13" Margin="14,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SubtotalSom, StringFormat='{}{0:N0} so‘m'}"
                                                               Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Height="1" Background="#5016A34A" Margin="0,14,0,12" />

                                    <!-- Total row -->
                                    <Grid>
                                        <TextBlock Text="Jami summa" Foreground="#CBD5E1" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalFormatted}" Foreground="#4ADE80" FontSize="26" FontWeight="ExtraBold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Customer & Delivery Card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Yetkazib berish ma‘lumotlari" Foreground="#E2E8F0" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Mijoz:" Foreground="#94A3B8" FontSize="14" />
                                        <TextBlock Text="{Binding CustomerName}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Telefon:" Foreground="#94A3B8" FontSize="14" />
                                        <TextBlock Text="{Binding CustomerPhone}" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Manzil:" Foreground="#94A3B8" FontSize="14" />
                                        <TextBlock Text="{Binding AddressText}" Foreground="#F8FAFC" FontSize="14" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="360" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Payment Information Card -->
                            <Border Background="#1E293B" CornerRadius="10" Padding="18" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="To‘lov holati" Foreground="#E2E8F0" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="To‘lov usuli:" Foreground="#94A3B8" FontSize="14" />
                                        <TextBlock Text="{Binding PaymentBadge}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Yetkazish varianti:" Foreground="#94A3B8" FontSize="14" />
                                        <TextBlock Text="{Binding DeliveryBadge}" Foreground="#F8FAFC" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Actions Bar: strictly derived from AllowedActions (Plan section 74) -->
                    <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="24,14">
                        <WrapPanel HorizontalAlignment="Right">
                            <!-- Qabul qilish -->
                            <Button Content="Qabul qilish" Click="Accept_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanAccept, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Tayyorlashni boshlash -->
                            <Button Content="Tayyorlashni boshlash" Click="Preparing_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanStartPreparing, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Qabul qildim: the kitchen has seen the paid order (also silences the bell) -->
                            <Button Content="Qabul qildim" Click="SetPrepTime_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanAcknowledge, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- To'lovni tasdiqlash -->
                            <Button Content="To‘lovni tasdiqlash" Click="VerifyPayment_Click" Style="{StaticResource ActionButtonWarning}"
                                    Visibility="{Binding CanVerifyPayment, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Tayyor -->
                            <Button Content="Tayyor" Click="MarkReady_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanMarkReady, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- O'zimiz yetkazdik -->
                            <Button Content="Yetkazildi" Click="SelfDelivered_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanSelfDeliver, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Bekor qilish -->
                            <Button Content="Bekor qilish" Click="Cancel_Click" Style="{StaticResource ActionButtonDanger}"
                                    Visibility="{Binding CanCancel, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Rad etish -->
                            <Button Content="Rad etish" Click="Reject_Click" Style="{StaticResource ActionButtonDanger}"
                                    Visibility="{Binding CanReject, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Qaytarishni tasdiqlash -->
                            <Button Content="Qaytarishni tasdiqlash" Click="ApproveRefund_Click" Style="{StaticResource ActionButtonSuccess}"
                                    Visibility="{Binding CanApproveRefund, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />

                            <!-- Qaytarishni rad etish -->
                            <Button Content="Qaytarishni rad etish" Click="RejectRefund_Click" Style="{StaticResource ActionButtonDanger}"
                                    Visibility="{Binding CanRejectRefund, Converter={x:Static vm:BooleanToVisibilityConverter.Instance}}" />
                        </WrapPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
