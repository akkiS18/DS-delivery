<Window x:Class="DsRestaurant.App.Views.Dialogs.VerifyPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To‘lovni tasdiqlash" 
        Width="480" Height="410"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Bank to‘lovini tasdiqlash" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock Text="Buyurtma puli hisobingizga kelganini tekshiring" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Body -->
        <StackPanel Grid.Row="1">
            <Border Background="#1E293B" CornerRadius="10" Padding="16" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Kutilayotgan summa:" Foreground="#94A3B8" FontSize="13" />
                        <TextBlock x:Name="AmountText" Text="0 so‘m" Foreground="#22C55E" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Karta oxirgi 4 raqami:" Foreground="#94A3B8" FontSize="13" />
                        <TextBlock x:Name="CardText" Text="**0000" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="Signal holati:" Foreground="#94A3B8" FontSize="13" />
                        <TextBlock x:Name="SignalText" Text="Kelgan" Foreground="#38BDF8" FontSize="13" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Warning Box (Plan line 85: mail/Telegram signal is NOT bank proof) -->
            <Border Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="8" Padding="12">
                <TextBlock Text="DIQQAT: Telegram yoki SMS signali bank kvitansiyasi emas. Pul restoranning rasmiy bank hisobiga kelganiga shaxsan ishonch hosil qilib, so‘ng tasdiqlang."
                           Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" LineHeight="18" />
            </Border>
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Bekor qilish" Click="Cancel_Click" Width="110" Height="40"
                    Background="Transparent" BorderThickness="1" BorderBrush="#475569" Foreground="#CBD5E1"
                    Cursor="Hand" Margin="0,0,12,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Pul keldi (Tasdiqlash)" Click="Confirm_Click" Width="180" Height="40"
                    Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
