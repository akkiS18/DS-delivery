<Window x:Class="DsRestaurant.App.Views.Dialogs.CategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toifa qo‘shish" 
        Width="400" Height="240"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Yangi toifa nomi:" Foreground="#F8FAFC" FontSize="16" FontWeight="Bold" Margin="0,0,0,14" />

        <TextBox x:Name="NameInput" Grid.Row="1" Height="38" Background="#1E293B" Foreground="#F8FAFC"
                 BorderBrush="#475569" BorderThickness="1" Padding="8,6" VerticalContentAlignment="Center" FontSize="13" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Bekor qilish" Click="Cancel_Click" Width="100" Height="38"
                    Background="Transparent" BorderThickness="1" BorderBrush="#475569" Foreground="#CBD5E1"
                    Cursor="Hand" Margin="0,0,10,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Qo‘shish" Click="Save_Click" Width="110" Height="38"
                    Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
