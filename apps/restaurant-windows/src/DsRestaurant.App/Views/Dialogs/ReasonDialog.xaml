<Window x:Class="DsRestaurant.App.Views.Dialogs.ReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sababni ko‘rsating" 
        Width="460" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="Bekor qilish sababi" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock x:Name="SubtitleText" Text="Iltimos, sababni tanlang yoki yozing:" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Options -->
        <StackPanel Grid.Row="1">
            <RadioButton x:Name="Opt1" Content="Mahsulot tugagan (OUT_OF_STOCK)" IsChecked="True"
                         Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10" />
            <RadioButton x:Name="Opt2" Content="Bajara olmaymiz (CANNOT_FULFIL)"
                         Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10" />
            <RadioButton x:Name="Opt3" Content="Restoran yopiq (CLOSED)"
                         Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10" />
            <RadioButton x:Name="Opt4" Content="Boshqa sabab (OTHER)"
                         Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,14" />

            <TextBlock Text="Qo‘shimcha izoh (ixtiyoriy):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6" />
            <TextBox x:Name="ReasonInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                     Padding="8" FontSize="13" />
        </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Bekor qilish" Click="Cancel_Click" Width="110" Height="40"
                    Background="Transparent" BorderThickness="1" BorderBrush="#475569" Foreground="#CBD5E1"
                    Cursor="Hand" Margin="0,0,12,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Tasdiqlash" Click="Confirm_Click" Width="130" Height="40"
                    Background="#DC2626" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
