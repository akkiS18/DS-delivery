<Window x:Class="DsRestaurant.App.Views.Dialogs.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taom ma'lumotlari" 
        Width="480" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="DialogTitle" Text="Yangi taom qo‘shish" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,18" />

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Nomi:" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="NameInput" Height="38" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                     Padding="8,6" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,14" />

            <TextBlock Text="Narxi (so‘m):" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="PriceInput" Height="38" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                     Padding="8,6" VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,14" />

            <TextBlock Text="Toifasi:" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,4" />
            <ComboBox x:Name="CategoryCombo" Height="38" Background="#1E293B" Foreground="#F8FAFC" Margin="0,0,0,14"
                      DisplayMemberPath="Name" SelectedValuePath="Id" />

            <TextBlock Text="Tavsifi (ixtiyoriy):" Foreground="#94A3B8" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="DescInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1"
                     Padding="8,6" FontSize="13" />
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Bekor qilish" Click="Cancel_Click" Width="110" Height="40"
                    Background="Transparent" BorderThickness="1" BorderBrush="#475569" Foreground="#CBD5E1"
                    Cursor="Hand" Margin="0,0,12,0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Saqlash" Click="Save_Click" Width="130" Height="40"
                    Background="#16A34A" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold"
                    Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
