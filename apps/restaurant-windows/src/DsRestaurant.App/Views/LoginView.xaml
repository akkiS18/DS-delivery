<UserControl x:Class="DsRestaurant.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DsRestaurant.App.ViewModels"
        xmlns:controls="clr-namespace:DsRestaurant.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:LoginViewModel}"
             Background="#0F172A">

    <Grid>
        <!-- Background subtle accent glow -->
        <Ellipse Width="450" Height="450" Fill="#15803D" Opacity="0.12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Effect>
                <BlurEffect Radius="120" />
            </Ellipse.Effect>
        </Ellipse>

        <!-- Login Card -->
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#1E293B" CornerRadius="16" Padding="32"
                BorderBrush="#334155" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.4" ShadowDepth="10" />
            </Border.Effect>

            <StackPanel>
                <!-- Brand Header: the real DS Delivery logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Image Source="pack://application:,,,/Resources/logo.png" Width="96" Height="96" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="DS Restaurant" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Oshxona va kassa dasturi" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Separator -->
                <Border Height="1" Background="#334155" Margin="0,18,0,20" />

                <!-- Error Message Banner -->
                <Border x:Name="ErrorBanner" CornerRadius="8" Background="#450A0A" BorderBrush="#DC2626" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={x:Static vm:StringNullOrEmptyToVisibilityConverter.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <controls:Icon Data="{StaticResource Ic.Warning}" Width="16" Height="16" Foreground="#FCA5A5" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="13" TextWrapping="Wrap"
                                   MaxWidth="300" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Slug Field -->
                <TextBlock Text="Restoran kodi (slug)" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="SlugBox" Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}"
                         Height="42" FontSize="14" Foreground="#F8FAFC" Background="#0F172A"
                         BorderBrush="#475569" BorderThickness="1" Padding="10,8"
                         VerticalContentAlignment="Center" Margin="0,0,0,16" />

                <!-- Password Field -->
                <TextBlock Text="Parol" Foreground="#CBD5E1" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordInput" Height="42" FontSize="14" Foreground="#F8FAFC" Background="#0F172A"
                             BorderBrush="#475569" BorderThickness="1" Padding="10,8"
                             VerticalContentAlignment="Center" Margin="0,0,0,16"
                             KeyDown="PasswordInput_KeyDown" />

                <!-- Login Button -->
                <Button x:Name="LoginBtn" Click="LoginButton_Click" Height="46" Margin="0,8,0,0"
                        Background="#16A34A" BorderThickness="0" Cursor="Hand"
                        IsEnabled="{Binding IsBusy, Converter={x:Static vm:InverseBooleanConverter.Instance}}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding IsBusy, Converter={x:Static vm:BusyTextConverter.Instance}}"
                                   Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
