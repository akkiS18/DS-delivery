<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG only. Cleartext is permitted so a debug APK can talk to a developer machine over HTTP; HTTPS keeps working normally. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
